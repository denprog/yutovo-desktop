                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Это Ютово - мощный калькулятор с графическим отображением математических операций совместно с текстовым ",
                                "format_id": "cf09763c-ef1f-4265-8ec1-d0afe2f34a07"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "редактором. Далее представлены его основные возможности.",
                                "format_id": "cf09763c-ef1f-4265-8ec1-d0afe2f34a07"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
