                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Вычисление выражений любого размера с любой точностью. Для выбора количества знаков после запятой и порядка ",
                                "format_id": "cf09763c-ef1f-4265-8ec1-d0afe2f34a07"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "кликните правой кнопкой на результате и выберите \"Точность\" или \"Порядок\".",
                                "format_id": "cf09763c-ef1f-4265-8ec1-d0afe2f34a07"
                            }
                        ]
