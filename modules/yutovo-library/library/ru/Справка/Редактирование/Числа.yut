                        "level": 1,
                        "elements": [
                            {
                                "id": "0,17,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Дробные числа представлены обыкновенной дробью. Ввод их производится с использованием символа деления (клавиша \"/\"), либо выбором этого символа в математической панели. Целую часть дроби, при ее наличии, можно вводить слитно с самой дробью, как это показано в следующем примере, так и через символ сложения.",
                                "format_id": "eefebd6c-6f94-4f91-a429-95a7d74c5dde"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
