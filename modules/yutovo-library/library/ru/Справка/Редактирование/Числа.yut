                    {
                        "id": "0,11,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Целые числа не имеют дробной части. Они могут быть двоичной, десятичной, восьмеричной, либо шестнадцатеричной нотации. Над ними можно производить логические операции.",
                                "format_id": "eefebd6c-6f94-4f91-a429-95a7d74c5dde"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
