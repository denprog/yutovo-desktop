            {
                "id": "0,55",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,55,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,55,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Для удобства редактирования поддерживаются операции с буфером обмена. Это позволяет быстро вводить похожие выражения, копировать части выражений и вставлять их в другие формулы.",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,56",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,56,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,56,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Для работы с буфером обмена предусмотрены кнопки на панели и быстрые клавиши, описанные в разделе Буфер обмена.",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
