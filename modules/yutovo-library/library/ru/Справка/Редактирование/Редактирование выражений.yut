                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "В начале выражение представлено пустой строкой в блоке кода:",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
