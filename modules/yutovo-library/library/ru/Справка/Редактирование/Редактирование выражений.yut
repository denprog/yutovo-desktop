                    {
                        "id": "0,9,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "При вводе числа (строки) курсор становится в позицию \"внутри строки\" и приобретает вид текстового курсора. Курсор можно передвинуть курсорными клавишами в другое положение внутри строки. Нажмите: [Left][Left][Left][Left][Left]. Курсор переместится на пять символов влево.Теперь ввод строки будет происходить в новом положении. Вводите: \"90\".",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
