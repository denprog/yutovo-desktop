                ],
                "format_name": "Пример",
                "format_alignment": 0
            },
            {
                "id": "0,32",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,32,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,32,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "В начатом выше пример удалим последний символ подкоренного выражения. Для этого курсорными клавишами или мышью поставьте курсор на конец подкоренного выражения и нажмите [Del]:",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
