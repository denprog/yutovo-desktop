                            {
                                "id": "0,51,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Теперь извлечем квадратный корень из выражения в знаменателе. Здесь опять поможет выделение. Сейчас курсор стоит в крайнем правом положении, значит, чтобы выделить знаменатель, нужно нажимать [Shift+Left] до полного выделения этого выражения, либо [Shift+Home] чтобы выделить всю строку. Затем введите операцию извлечения корня нажав [Shift+Ctrl+Q].",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
