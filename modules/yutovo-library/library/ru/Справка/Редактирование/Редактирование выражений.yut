                "elements": [
                    {
                        "id": "0,38,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,38,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Как видим, параметры - степень корня и подкоренное выражение остались, удалился только сам корень. Аналогичным образом можно удалить символ деления. Из прошлой позиции нажмите [Up], чтобы передвинуть курсор на позицию перед символом деления и удалите его:",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
