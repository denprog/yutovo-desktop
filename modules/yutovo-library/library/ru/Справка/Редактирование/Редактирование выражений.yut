            },
            {
                "id": "0,30",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,30,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,30,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Символы в строке удаляются просто, как принято это в редакторах. Нужно подвести курсор к нужному символу и нажать [Del], если символ находится справа, или [Backspace], если символ слева.",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
