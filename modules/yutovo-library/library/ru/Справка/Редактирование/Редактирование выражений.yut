            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Курсорные клавиши позволяют перемещаться по формулам. Курсор влево и вправо (клавиши [Стрелка влево] и [Стрелка вправо]) движется последовательно с формулы на формулу. При движении вверх ([Стрелка вверх]) и вниз ([Стрелка вниз]) курсор переходит на ближайшую верхнюю или нижнюю ветвь. Клавишами [Ctrl]-[Стрелка влево] и [Ctrl]-[Стрелка вправо] можно двигать курсор не входя во вложенные элементы. Клавиша [Home] служит для перехода курсора к более общей ветви, либо в начало строки.",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
