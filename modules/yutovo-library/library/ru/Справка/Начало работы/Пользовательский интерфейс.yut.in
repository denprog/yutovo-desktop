            },
            {
                "id": "0,7",
                "type": 2,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "elements": "Расположена слева и содержит документы текущего пользователя. Появляется после логина. При клике на документе он загружается, математические выражения в нем вычисляются.",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "elements": "Панель библиотеки",
                                "format_id": "487901ec-7161-4565-a4af-41f29241ca5c"
                            }
                        ]
                    }
                ],
                "format_name": "Заголовок 4",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "elements": "Расположена слева и содержит примеры использования, справочную и различную вспомогательную информацию. Загруженный из библиотеки документ можно редактировать, однако сохранить ",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            }
                        ]
                    },
                    {
                        "id": "0,9,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,1,0",
                                "type": 4,
                                "elements": "в свои документы возможно только после логина.",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,10",
                "type": 2,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "elements": "Панель обозначений",
                                "format_id": "487901ec-7161-4565-a4af-41f29241ca5c"
                            }
                        ]
                    }
                ],
                "format_name": "Заголовок 4",
                "format_alignment": 0
            },
            {
                "id": "0,11",
                "type": 2,
                "elements": [
                    {
                        "id": "0,11,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "elements": "Содержит встроенные и пользовательские переменные, функции и размерности, отсортированные по алфавиту и по физическому смыслу (размерности). Пользовательские идентификаторы ",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            }
                        ]
                    },
                    {
                        "id": "0,11,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,1,0",
                                "type": 4,
                                "elements": "появляются в этой панели при вводе их в текущем документе.",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
