    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Каждый документ имеет набор настроек, которые задаются в диалоге Свойств документа, вызываемого кнопкой ",
                                "format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": ".",
                                "format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Вкладка Результат",
                                "format_id": "9a687d97-ef48-4587-91ec-f82063ff8da9"
                            }
                        ],
                        "format_name": "Заголовок 4"
                    }
                ],
                "format_name": "Заголовок 4",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Здесь перечислены настройки по умолчанию для вычисления выражений.",
                                "format_id": "16a8a98c-4046-49bd-9917-93e3b753317a"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Автоподбор результата - при вычислении выражения будут последовательно перебираться варианты типов результатов, перечисленные в таблице ниже, до тех пор, пока выражение не будет успешно вычислено. Если все варианты выдали ошибки, вернется ошибка для первого варианта вычислений.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Порядок подбора результата - в таком порядке будут перебираться варианты вычисления текущего выражения. Чаще всего выражения вычисляются в вещественных числах, поэтому этот вариант стоит первым по умолчанию. Например, чтобы в первую очередь представлять выражение в виде правильной дроби, поставьте Дробные на первое место.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Вещественные, Целые, Дробные, Комплексные - на этих вкладках представлены параметры этих результатов по умолчанию. В дальнейшем их можно менять для каждого результата путем выбора из контексного меню.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Вкладка Документ",
                                "format_id": "9a687d97-ef48-4587-91ec-f82063ff8da9"
                            }
                        ],
                        "format_name": "Заголовок 4"
                    }
                ],
                "format_name": "Заголовок 4",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Язык - текущий язык документа. От него зависят набор размерностей и некоторых переменных. Например, для английского языка мнимая единица - это \"i\", а для русского - \"j\". Размерности пишутся на своем языке.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Табуляция - использовать символы табуляции или определенное количество пробелов взамен этого.",
                                "format_id": "ff4e2bcb-21f7-4546-96f8-98c892e5a619"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "level": 1,
                "elements": [
