    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Ютово поддерживает размерности чисел и системы размерностей. Есть встроенные и пользовательские размерности. Размерность определяется символом ",
                                "format_id": "41fb8729-e3da-41f3-b3ea-78a52b80cd02"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": " (клавиша \"~\"). Определение размерности должно производиться до ее первого использования. Можно определять любые составные размерности, присваивая им имена. В дальнейшем, если в вычисляемом выражении используются размерности, результат будет представлен с наиболее подходящей размерностью.",
                                "format_id": "41fb8729-e3da-41f3-b3ea-78a52b80cd02"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Размерности представлены для вещественных, дробных и комплексных чисел. В числах целого типа размерностей нет.",
                                "format_id": "41fb8729-e3da-41f3-b3ea-78a52b80cd02"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Встроенные размерности определены следующих систем: СИ, русская, американская и внесистемные.",
                                "format_id": "41fb8729-e3da-41f3-b3ea-78a52b80cd02"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Использование тех или иных размерностей зависит от текущего языка (локали) документа, который устанавливается в настройках по кнопке ",
                                "format_id": "c6640fbe-09ef-4491-b822-b5f32fa0f228"
                            },
                            {
                                "id": "0,3,0,1",
                                "type": 34,
