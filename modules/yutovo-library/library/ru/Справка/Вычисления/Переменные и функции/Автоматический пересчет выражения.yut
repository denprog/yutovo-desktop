    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Если выражение зависит от какой-либо переменной или функции, то было бы удобно автоматически пересчитывать это выражение при ее (переменной или функции) изменении. Ютово позволяет это делать. Зависящие выражения пересчитываются автоматически через заданное время.",
                                "format_id": "b6dfc967-2f9a-49eb-9099-5fab0f07016f"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
