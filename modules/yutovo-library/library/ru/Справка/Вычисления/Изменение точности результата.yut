    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Изменение точности результата возможно только для экспоненциальных и комплексных чисел. У целых и ",
                                "format_id": "8fc5b17e-625d-4d0c-b231-6be959b5f53d"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "дробных чисел нет плавающей точки.",
                                "format_id": "8fc5b17e-625d-4d0c-b231-6be959b5f53d"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Сначала результат вычисляется с точностью по умолчанию, задаваемой в настройках документа. В ",
                                "format_id": "8fc5b17e-625d-4d0c-b231-6be959b5f53d"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "дальнейшем для каждого полученного результата точность можно изменить. Это делается с помощью клика ",
                                "format_id": "8fc5b17e-625d-4d0c-b231-6be959b5f53d"
                            }
                        ]
                    },
                    {
                        "id": "0,1,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,2,0",
                                "type": 4,
                                "elements": "правой кнопкой мыши на результате и выбором \"Точность\". В появившемся диалоге нужно выбрать точность в ",
                                "format_id": "8fc5b17e-625d-4d0c-b231-6be959b5f53d"
                            }
                        ]
                    },
                    {
                        "id": "0,1,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,3,0",
                                "type": 4,
                                "elements": "пределах от 1 до 100 и нажать OK. Выражение будет пересчитано с новой точностью.",
                                "format_id": "8fc5b17e-625d-4d0c-b231-6be959b5f53d"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Пример:",
                                "format_id": "a23f39ea-a696-4e7d-a10b-ffe2f07197cb"
                            }
                        ]
                    }
                ],
                "format_name": "Пример",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
