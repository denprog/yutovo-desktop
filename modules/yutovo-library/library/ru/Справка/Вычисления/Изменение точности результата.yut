                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "Следующее выражение посчитано с точностью 3.",
                                "format_id": "8fc5b17e-625d-4d0c-b231-6be959b5f53d"
                            }
