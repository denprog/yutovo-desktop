    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Вычисление выражения, находящегося в блоке калькулятора производится нажатием клавиши \"=\" либо выбором ее символа в ",
                                "format_id": "f3b9e62c-baba-4166-8119-a9411f022e1e"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "панели.",
                                "format_id": "f3b9e62c-baba-4166-8119-a9411f022e1e"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Вычислять можно в ",
                                "format_id": "4ad254b3-25dd-4a89-ac31-dd13b319a6ad"
                            },
                            {
                                "id": "0,1,0,1",
