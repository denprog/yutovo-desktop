                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• двоичная - цифры \"0\", \"1\";",
                                "format_id": "dd33cfb9-1bf4-44bf-b3c2-d89a3be6db3e"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
