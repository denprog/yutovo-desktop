    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Документы пользователя хранятся на сайте, их список отбражается в разделе Документы. В данное время максимальное количество документов одного пользователя - 50, максимальный ",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "размер каждого документа - 1 Мбайт.",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "После успешного логина становятся доступны следующие возможности для работы с документами и соответствующие кнопки на панели инструментов.",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,2,0,1",
                                "type": 4,
                                "elements": " - создать документ; ему присваивается имя по умолчанию.",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,3,0,1",
                                "type": 4,
                                "elements": " - загрузить документ с компьютера пользователя; в веб версии - в дальнейшем он может быть сохранен в разделе пользователя на сайте.",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,4,0,1",
                                "type": 4,
                                "elements": " - сохранить документ.",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,5,0,1",
                                "type": 4,
                                "elements": " - сохранить документ с новым именем.",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,6,0,1",
                                "type": 4,
                                "elements": " - скачать документ на компьютер пользователя; в дальнейшем он может быть открыт приложением Ютово для ПК.",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,7,0,1",
                                "type": 4,
                                "elements": " - переименовать документ.",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,8,0,1",
                                "type": 4,
                                "elements": " - удалить документ.",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "elements": "Документ, хранящийся на сайте открывается по клику на его имени в разделе Документы. После этого этим документом можно делиться с другими людьми - для этого надо им передать его ",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ]
                    },
                    {
                        "id": "0,9,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,1,0",
                                "type": 4,
                                "elements": "адрес из строки браузера. Они смогут просматривать и редактировать этот документ, но сохранить смогут только в свой аккуаунт.",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,10",
                "type": 2,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "elements": "Документы из библиотеки также можно сохранить в свой раздел - после сохранения он появится в соответствующей панели. Таким образом, примеры и различные материалы из библиотеки ",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ]
                    },
                    {
                        "id": "0,10,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,10,1,0",
                                "type": 4,
                                "elements": "можно использовать как начальная точка для ваших расчётов.",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,11",
                "type": 2,
                "elements": [
                    {
                        "id": "0,11,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "elements": "Каждый документ имеет связанный с ним язык (локаль), который задаётся в настройках документа по кнопке ",
                                "format_id": "8931bd81-530f-4389-b002-a6ead32854ba"
                            },
                            {
                                "id": "0,11,0,1",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,11,0,2",
                                "type": 4,
                                "elements": ". Язык определяет набор встроенных переменных, функций и размерностей, ",
                                "format_id": "8931bd81-530f-4389-b002-a6ead32854ba"
                            }
                        ]
                    },
                    {
                        "id": "0,11,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,1,0",
                                "type": 4,
                                "elements": "которые будут использоваться в вычислениях.",
                                "format_id": "8931bd81-530f-4389-b002-a6ead32854ba"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
