                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Жидкость превращается в пар при постоянной температуре кипения. Энергия Q расходуется на разрыв межмолекулярных связей, а не ",
                                "format_id": "6f1f8a7c-d8d9-45d3-923c-4dc5495eff23"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "на нагрев. L — удельная теплота парообразования, Дж/кг; m — масса жидкости, кг.",
                                "format_id": "6f1f8a7c-d8d9-45d3-923c-4dc5495eff23"
                            }
                        ]
                    }
                ],
