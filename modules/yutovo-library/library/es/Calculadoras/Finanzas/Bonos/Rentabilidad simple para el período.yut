                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "La calculadora de rendimiento simple para el período calcula el rendimiento total de un bono recibido durante todo el tiempo de posesión, teniendo en cuenta la diferencia de precio de compra y venta y los ",
                                "format_id": "8fd6f87b-ac10-4891-8dc6-40c013c9123e"
                            }
                        ]
                    },
                    {
                        "id": "0,4,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,1,0",
                                "type": 4,
                                "elements": "pagos recibidos. Cambie los parámetros y el resultado se volverá a calcular.",
                                "format_id": "8fd6f87b-ac10-4891-8dc6-40c013c9123e"
                            }
                        ]
                    }
                ],
