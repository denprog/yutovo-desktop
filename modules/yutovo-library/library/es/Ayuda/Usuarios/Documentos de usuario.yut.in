                            },
                            {
                                "id": "0,3,0,1",
                                "type": 4,
                                "elements": " - cargar un documento desde el ordenador del usuario; en la versión web se puede guardar en la sección de usuario del sitio.",
                                "format_id": "8bcdf2e0-7e59-4f0a-b534-4d760ebac370"
                            }
                        ]
                    }
                ],
                "format_name": "Cuerpo de texto",
