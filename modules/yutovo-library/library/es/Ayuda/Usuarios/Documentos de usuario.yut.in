                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,2,0,1",
                                "type": 4,
                                "elements": " - crear un documento; se le asigna un nombre predeterminado.",
                                "format_id": "8bcdf2e0-7e59-4f0a-b534-4d760ebac370"
                            }
                        ]
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
