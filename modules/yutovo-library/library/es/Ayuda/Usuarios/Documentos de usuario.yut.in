                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,8,0,1",
                                "type": 4,
                                "elements": " - eliminar el documento.",
                                "format_id": "8bcdf2e0-7e59-4f0a-b534-4d760ebac370"
                            }
                        ]
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "elements": "Un documento almacenado en el sitio se abre haciendo clic en su nombre en la sección Documentos. Después, se puede compartir con otras personas; para ello, se debe proporcionar su dirección desde el ",
                                "format_id": "8bcdf2e0-7e59-4f0a-b534-4d760ebac370"
                            }
                        ]
                    },
                    {
                        "id": "0,9,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,1,0",
                                "type": 4,
                                "elements": "navegador. Podrán ver y editar este documento, pero solo podrán guardarlo en su cuenta.",
                                "format_id": "8bcdf2e0-7e59-4f0a-b534-4d760ebac370"
                            }
                        ]
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
            {
                "id": "0,10",
                "type": 2,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "elements": "Los documentos de la biblioteca también pueden guardarse en su sección; tras guardarlos, aparecerán en el panel correspondiente. De esta forma, podrán usar ejemplos y diversos materiales de la ",
                                "format_id": "8bcdf2e0-7e59-4f0a-b534-4d760ebac370"
                            }
                        ]
                    },
                    {
                        "id": "0,10,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,10,1,0",
                                "type": 4,
                                "elements": "biblioteca como punto de partida para sus cálculos. Cada documento tiene un idioma asociado (configuración regional), que se configura en la configuración del documento haciendo clic en el botón ",
                                "format_id": "8bcdf2e0-7e59-4f0a-b534-4d760ebac370"
                            },
                            {
                                "id": "0,10,1,1",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,10,1,2",
                                "type": 4,
                                "elements": ". El ",
                                "format_id": "8bcdf2e0-7e59-4f0a-b534-4d760ebac370"
                            }
                        ]
                    },
                    {
                        "id": "0,10,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,10,2,0",
                                "type": 4,
                                "elements": "idioma determina el conjunto de variables, funciones y dimensiones integradas que se utilizarán en los cálculos.",
                                "format_id": "8bcdf2e0-7e59-4f0a-b534-4d760ebac370"
                            }
                        ]
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
