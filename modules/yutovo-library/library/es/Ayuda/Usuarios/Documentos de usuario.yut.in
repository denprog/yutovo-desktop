                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Los documentos del usuario se almacenan en el sitio y su lista se muestra en la sección Documentos. Actualmente, el número máximo de documentos por usuario es de 50, con un tamaño máximo de 1 MB por documento.",
                                "format_id": "8bcdf2e0-7e59-4f0a-b534-4d760ebac370"
                            }
                        ]
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Tras iniciar sesión correctamente, estarán disponibles las siguientes opciones para trabajar con documentos y los botones correspondientes en la barra de herramientas:",
                                "format_id": "8bcdf2e0-7e59-4f0a-b534-4d760ebac370"
                            }
                        ]
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
