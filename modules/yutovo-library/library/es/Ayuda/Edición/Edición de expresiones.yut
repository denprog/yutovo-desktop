                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Al introducir un número (cadena), el cursor se mueve a la posición \"dentro de la cadena\" y adopta la forma de un cursor de texto. Puede mover el cursor a otra posición dentro de la cadena con las teclas de cursor. Pulse: [Izquierda][Izquierda][Izquierda][Izquierda][Izquierda]. El cursor se moverá cinco caracteres a la izquierda. La cadena se introducirá en la nueva posición. Introduzca: \"90\".",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ],
                        "format_name": "Cuerpo de texto"
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
