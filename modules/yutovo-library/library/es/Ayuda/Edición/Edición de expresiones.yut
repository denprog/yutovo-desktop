            {
                "id": "0,34",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,34,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,34,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Se puede eliminar una operación previamente introducida. Eliminar una operación significa eliminar solo el símbolo de la operación, conservando sus parámetros. Para ello, pulse [Del] cuando el cursor esté en la posición \"antes de la operación\".",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ],
                        "format_name": "Cuerpo de texto"
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
