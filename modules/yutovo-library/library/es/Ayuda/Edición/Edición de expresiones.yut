            {
                "id": "0,30",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,30,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,30,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Los caracteres de una línea se eliminan de forma sencilla, como es habitual en los editores. Debe mover el cursor al carácter deseado y pulsar [Del] si está a la derecha o [Retroceso] si está a la izquierda.",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ],
                        "format_name": "Cuerpo de texto"
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
