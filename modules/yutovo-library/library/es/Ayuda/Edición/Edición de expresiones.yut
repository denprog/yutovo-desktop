                                                    {
                                                        "id": "0,8,0,0,0,0,0",
                                                        "type": 8,
                                                        "level": 1,
                                                        "elements": "1234.5678",
                                                        "format_id": "e254f8da-75d2-4960-80da-53bae4501b8b",
                                                        "can_merge": true
                                                    }
                                                ]
                                            }
                                        ],
                                        "format_name": "Código",
                                        "format_alignment": 0
                                    }
                                ],
                                "code_id": 1
                            }
                        ],
