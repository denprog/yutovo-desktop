            {
                "id": "0,46",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,46,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,46,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "En la expresión del ejemplo anterior dividámosla por un número. Para ello, primero selecciónela con el ratón o las teclas del cursor. La selección con las teclas del cursor se realiza pulsando sucesivamente [Mayús+Arriba] o [Mayús+Abajo] hasta seleccionar toda la expresión. A continuación, pulse \"/\" para introducir la operación de división.",
                                "format_id": "55aabe80-137a-4e24-92ac-ec4c4390cfc4"
                            }
                        ],
                        "format_name": "Cuerpo de texto"
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
