                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "A calculadora de rendimento efetivo, incluindo reinvestimento, calcula o rendimento total de um título, levando em consideração os pagamentos de cupom e o reinvestimento (capitalização) dos cupons à mesma taxa até o vencimento. Altere os parâmetros e o resultado será recalculado.",
                                "format_id": "07a77251-0b70-41b5-acdd-539669c86773"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
