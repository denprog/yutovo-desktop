            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Quatro sistemas numéricos são suportados: binário (bin), octal (oct), decimal (dec), hexadecimal (hex).",
                                "format_id": "209cd4ff-ccba-42d8-8720-df26a2d54f37"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Nas configurações de números inteiros, você pode definir o sistema numérico padrão e o sistema numérico para o resultado. Para cálculos ",
                                "format_id": "f7fe7dfb-1aae-4ded-889d-c818204837c0"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "cálculos, você pode selecionar o sistema numérico separadamente.",
                                "format_id": "f7fe7dfb-1aae-4ded-889d-c818204837c0"
                            }
                        ]
                    }
                ],
