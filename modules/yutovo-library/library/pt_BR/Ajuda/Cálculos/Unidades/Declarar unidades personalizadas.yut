                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Aqui a unidade \"cube_m\" é declarada, igual a cinquenta metros cúbicos. Ao calcular, ela é substituída no resultado ",
                                "format_id": "cf5daa11-a526-4b88-aa12-03e8df04e70e"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": " já que neste exemplo é a mais simples.",
                                "format_id": "cf5daa11-a526-4b88-aa12-03e8df04e70e"
                            }
                        ]
                    }
                ],
