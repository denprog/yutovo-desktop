    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Yutovo contém um grande número de unidades integradas. No entanto, às vezes elas não são suficientes. Unidades personalizadas são formadas ",
                                "format_id": "cf5daa11-a526-4b88-aa12-03e8df04e70e"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": " integradas declarando-as no documento. Elas são declaradas pelo botão ",
                                "format_id": "cf5daa11-a526-4b88-aa12-03e8df04e70e"
                            },
                            {
                                "id": "0,0,1,1",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,1,2",
                                "type": 4,
                                "elements": "ou a tecla \"~\".",
                                "format_id": "cf5daa11-a526-4b88-aa12-03e8df04e70e"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
