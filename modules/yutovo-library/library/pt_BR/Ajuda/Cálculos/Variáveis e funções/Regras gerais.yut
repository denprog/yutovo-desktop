    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "• Uma variável ou função deve ser declarada antes de ser usada pela primeira vez.",
                                "format_id": "4fdd1b23-5fe6-46d0-8197-303b48dafb0f"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "• Uma variável ou função pode ser definida mais de uma vez. Isso é chamado de redefinição.",
                                "format_id": "4fdd1b23-5fe6-46d0-8197-303b48dafb0f"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "• Ao redefinir uma variável ou função, a regra de ordem do documento se aplica: a variável ou função mais próxima de cima é usada na expressão.",
                                "format_id": "4fdd1b23-5fe6-46d0-8197-303b48dafb0f"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "cima é usada na expressão.",
                                "format_id": "4fdd1b23-5fe6-46d0-8197-303b48dafb0f"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "• Uma função pode ter qualquer número de parâmetros, separados por vírgulas.",
                                "format_id": "4fdd1b23-5fe6-46d0-8197-303b48dafb0f"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "• Variáveis e funções integradas podem ser redefinidas.",
                                "format_id": "4fdd1b23-5fe6-46d0-8197-303b48dafb0f"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "• Uma função pode ser redefinida para aceitar um número diferente de argumentos.",
                                "format_id": "4fdd1b23-5fe6-46d0-8197-303b48dafb0f"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
