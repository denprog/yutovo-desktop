                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "a variável pela presença de colchetes. Isso se refere tanto a variáveis e funções integradas quanto definidas pelo usuário.",
                                "format_id": "d177424f-30d7-4653-a938-3739f51c5650"
                            }
