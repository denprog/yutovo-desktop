                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Yutovo suporta variáveis e funções do usuário. Graças a elas, o usuário não é limitado pelas capacidades integradas, mas pode expandi-las.",
                                "format_id": "4d881c0d-254e-4eca-8588-ab4692b7d64a"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "pode expandi-las.",
                                "format_id": "4d881c0d-254e-4eca-8588-ab4692b7d64a"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
