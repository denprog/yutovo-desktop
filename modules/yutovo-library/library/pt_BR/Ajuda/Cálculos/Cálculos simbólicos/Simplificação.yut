                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "A simplificação é a redução de uma expressão à sua forma mais compacta. Esta função combina termos semelhantes, reduz frações, elimina operações redundantes. Se a fórmula original ficou complicada após cálculos intermediários, isso a torna concisa e legível. O resultado pode ser apresentado em números reais, fracionários ou complexos (selecionado através do menu de contexto no resultado).",
                                "format_id": "ddc030fa-0ae3-4416-9f6f-f698aac9bd41"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
