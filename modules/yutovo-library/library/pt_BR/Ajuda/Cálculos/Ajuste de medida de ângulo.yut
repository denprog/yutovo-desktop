    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Alterar a medida de ângulo só é possível para números reais e complexos.",
                                "format_id": "202e4c41-d528-4195-a9e5-c52a82e3acb2"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "A medida de ângulo padrão é definida nas configurações do documento. Pode ser alterada no menu de contexto do resultado selecionando \"Medida de ângulo padrão\".",
                                "format_id": "202e4c41-d528-4195-a9e5-c52a82e3acb2"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "selecionando \"Medida de ângulo padrão\".",
                                "format_id": "202e4c41-d528-4195-a9e5-c52a82e3acb2"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Exemplo:",
                                "format_id": "c4e163a0-e625-4822-b5a5-2f27d48b3cbe"
                            }
                        ]
                    }
                ],
                "format_name": "Exemplo",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "Na expressão a seguir, a medida de ângulo em radianos é definida por padrão nas configurações. Portanto, o seno é ",
                                "format_id": "202e4c41-d528-4195-a9e5-c52a82e3acb2"
                            }
                        ]
                    },
                    {
                        "id": "0,3,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,1,0",
                                "type": 4,
                                "elements": "calculado a partir de 2,5 radianos, e a tangente é calculada a partir de 5,34 graus, já que esta medida está explicitamente ",
                                "format_id": "202e4c41-d528-4195-a9e5-c52a82e3acb2"
                            }
                        ]
                    },
                    {
                        "id": "0,3,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,2,0",
                                "type": 4,
                                "elements": "explicitamente.",
                                "format_id": "202e4c41-d528-4195-a9e5-c52a82e3acb2"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
