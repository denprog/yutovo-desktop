    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Inicialmente, uma expressão é calculada usando a seleção automática do tipo de resultado. No entanto, para conveniência ",
                                "format_id": "cf36a62a-b5d9-43e2-8d2b-66e3a84fed10"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "apresentação, o tipo de resultado calculado após o símbolo de igual pode ser alterado. Para isso, clique com o botão direito no resultado ",
                                "format_id": "cf36a62a-b5d9-43e2-8d2b-66e3a84fed10"
                            }
                        ]
                    },
                    {
                        "id": "0,0,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,2,0",
                                "type": 4,
                                "elements": "e selecione o tipo de resultado desejado no submenu \"Apresentar como\".",
                                "format_id": "cf36a62a-b5d9-43e2-8d2b-66e3a84fed10"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
