                "elements": [
                    {
                        "id": "0,13,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,13,0,0",
                                "type": 4,
                                "elements": "No caso da posição do cursor \"dentro da linha\", a string de caracteres é editada, por exemplo, um número ou variável é digitado, assim como no texto. O cursor assume a forma de uma linha vertical sólida, que marca o lugar onde o novo caractere será digitado.é digitado, assim como no texto. O cursor assume a forma de uma linha vertical sólida, que marca o lugar onde o novonovo caractere será digitado.",
                                "format_id": "4189a81e-58dd-4a1a-8d10-fa98f5b23122"
                            }
                        ],
                        "format_name": "Cabeçalho 4"
                    }
                ],
