    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "O cursor do editor mostra a posição onde o usuário estará digitando texto no momento. Sua posição determina o que o usuário pode fazer para editar o documento. O cursor pode estar em quatro posições principais:pode fazer para editar o documento. O cursor pode estar em quatro posições principais:",
                                "format_id": "4189a81e-58dd-4a1a-8d10-fa98f5b23122"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "• dentro de uma linha, caso em que não é diferente do cursor de um editor de texto comum;",
                                "format_id": "4189a81e-58dd-4a1a-8d10-fa98f5b23122"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "• antes de uma operação matemática, que pode consistir em um único símbolo (\"+\", \"-\"), ou um composto (divisão, raiz);",
                                "format_id": "4189a81e-58dd-4a1a-8d10-fa98f5b23122"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "• após a última operação;",
                                "format_id": "4189a81e-58dd-4a1a-8d10-fa98f5b23122"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "• antes do símbolo de operação composta (para divisão - uma linha horizontal, para exponenciação - um retângulo vazio).",
                                "format_id": "4189a81e-58dd-4a1a-8d10-fa98f5b23122"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "No caso da posição \"antes da operação\", a inserção será realizada antes da operação. O cursor parece uma linha vertical localizada antes da operação e uma linha sublinhando esta operação.linha vertical localizada antes da operação e uma linha sublinhando esta operação.",
                                "format_id": "4189a81e-58dd-4a1a-8d10-fa98f5b23122"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "elements": "Exemplo:",
                                "format_id": "2c4f2316-d596-47b0-b9f8-f1e6a7cad850"
                            }
                        ],
                        "format_name": "Exemplo"
                    }
                ],
                "format_name": "Exemplo",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "elements": "Neste caso, o cursor está antes da operação de divisão.",
                                "format_id": "4189a81e-58dd-4a1a-8d10-fa98f5b23122"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,8,0,0",
