            },
            {
                "id": "0,9",
                "type": 2,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "elements": "A posição \"antes do símbolo\" é caracterizada pelo fato de que o cursor limita a representação gráfica da  operação. Neste caso, colar da área de transferência é impossível, mas excluir um símbolo é possível - então a operação ção. Neste caso, colar ",
                                "format_id": "4189a81e-58dd-4a1a-8d10-fa98f5b23122"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
