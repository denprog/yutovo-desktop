                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "elements": "Aqui o cursor está na posição \"antes do símbolo\".",
                                "format_id": "4189a81e-58dd-4a1a-8d10-fa98f5b23122"
                            }
                        ],
                        "format_name": "Corpo do texto"
