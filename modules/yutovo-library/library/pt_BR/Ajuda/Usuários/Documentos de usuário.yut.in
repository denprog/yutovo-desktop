                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Os documentos do usuário são armazenados no site e uma lista deles é exibida na seção Documentos. Atualmente, o número máximo de documentos por usuário é 50 e o tamanho máximo de cada documento é de 1 MB.",
                                "format_id": "0a8e2319-e38b-4975-a3e1-f7cbf881269e"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Após o login bem-sucedido, os seguintes recursos de gerenciamento de documentos e os botões correspondentes na barra de ferramentas ficam disponíveis.",
                                "format_id": "0a8e2319-e38b-4975-a3e1-f7cbf881269e"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
