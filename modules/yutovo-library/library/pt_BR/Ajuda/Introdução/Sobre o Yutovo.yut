                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• O Yutovo usa unidades e sistemas de unidades e pode converter valores entre eles.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
