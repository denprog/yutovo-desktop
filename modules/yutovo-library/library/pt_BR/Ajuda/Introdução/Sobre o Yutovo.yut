    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "O Yutovo é um aplicativo para resolver diversos problemas matemáticos. O Yutovo possui uma visualização em \"papel\" para cálculos. Ele usa uma sintaxe matemática geralmente aceita para exibir fórmulas. O Yutovo foi projetado para resolver problemas cotidianos e de engenharia e é adequado para uma ampla gama de usuários em diversas áreas.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• O Yutovo usa uma representação gráfica de fórmulas matemáticas.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Os resultados dos cálculos podem ter qualquer número de dígitos e ",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            },
                            {
                                "id": "0,2,0,1",
                                "type": 39,
                                "level": 1,
                                "elements": "precisão",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Cálculos/Ajuste de precisão de resultado.yut"
                            },
                            {
                                "id": "0,2,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": ".",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• O Yutovo trabalha com os seguintes tipos de números: ",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            },
                            {
                                "id": "0,3,0,1",
