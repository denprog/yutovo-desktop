                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Variáveis e funções do usuário são suportadas.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
