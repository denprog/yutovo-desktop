                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• O recálculo automático de expressões ajuda os usuários a observar os resultados dos cálculos ao editar fórmulas.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
