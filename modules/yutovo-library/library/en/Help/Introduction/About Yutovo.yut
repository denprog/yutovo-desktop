                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "• The measure of an angle can be changed.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "• Commonly used mathematical functions and constants are supported.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "elements": "• User variables and functions are supported.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "elements": "• Yutovo uses units and unit systems and can translate values ​​between them.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "elements": "• Automatic recalculation of expressions helps users observe the results of calculations when editing formulas.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "elements": [
