            },
            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
