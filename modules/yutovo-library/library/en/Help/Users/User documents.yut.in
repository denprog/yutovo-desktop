                            },
                            {
                                "id": "0,3,0,1",
                                "type": 4,
                                "level": 1,
                                "elements": " - upload a document from the user's computer; in the web version it can then be saved in the user's section on the site.",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ],
                        "format_name": "Text body"
