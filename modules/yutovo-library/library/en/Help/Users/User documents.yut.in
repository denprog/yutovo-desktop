                            },
                            {
                                "id": "0,6,0,1",
                                "type": 4,
                                "level": 1,
                                "elements": " - download the document to the user's computer; it can then be opened by the Yutovo application for PC.",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
