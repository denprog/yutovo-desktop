                "elements": [
                    {
                        "id": "0,13,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,13,0,0",
                                "type": 39,
                                "level": 1,
                                "elements": "<- User registration",
                                "format_id": "d338b315-a9b4-4a00-8a75-7f4d6e02c9b0",
                                "url": "./User registration.yut"
                            },
                            {
                                "id": "0,13,0,1",
                                "type": 4,
                                "level": 1,
                                "elements": "  ",
                                "format_id": "d7dbc119-d4ee-4a78-8699-7002385c3e62"
                            },
                            {
                                "id": "0,13,0,2",
                                "type": 39,
