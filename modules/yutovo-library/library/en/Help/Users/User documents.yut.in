    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "The user's documents are stored on the site, their list is displayed in the Documents section. Currently, the maximum number of documents for one user is 50, the maximum size of each document is 1 MB.",
                                "format_id": "69ad9bd4-428f-4f58-92a3-eb428e821558"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "After successful login, the following options for working with documents and the corresponding buttons on the toolbar become available.",
                                "format_id": "69ad9bd4-428f-4f58-92a3-eb428e821558"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,2,0,1",
                                "type": 4,
                                "level": 1,
                                "elements": " - create a document with a default name.",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
