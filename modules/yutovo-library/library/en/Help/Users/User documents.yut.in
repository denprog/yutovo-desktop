                            },
                            {
                                "id": "0,8,0,1",
                                "type": 4,
                                "level": 1,
                                "elements": " - delete the document.",
                                "format_id": "6fa11dac-2d2c-4917-9d23-35fd63785a19"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "A document stored on the site opens by clicking on its name in the Documents section. After that, this document can be shared with other people - to do this, you need to give them its address from the browser line. They will be able to view and edit this document, but they will only be able to save it to their account.",
                                "format_id": "69ad9bd4-428f-4f58-92a3-eb428e821558"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,10",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Documents from the library can also be saved to their section - after saving, it will appear in the corresponding panel. Thus, examples and various materials from the library can be used as a starting point for your calculations.",
                                "format_id": "69ad9bd4-428f-4f58-92a3-eb428e821558"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,11",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,11,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Every document has an associated locale, which is set in the document settings by clicking the button ",
                                "format_id": "a1d49acb-7fa7-43e7-bbd4-50b6fc128420"
                            },
                            {
                                "id": "0,11,0,1",
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,11,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": ". The locale determines the set of built-in variables, functions, and units that will be used in calculations.",
                                "format_id": "a1d49acb-7fa7-43e7-bbd4-50b6fc128420"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
