    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Yutovo allows you to compute expressions in their formal symbolic form. Symbolic computation is an area of computer mathematics where programs work not with numbers, but with mathematical expressions in their exact symbolic form. If ordinary numerical computations give a result as a number, then with symbolic computations instead of approximate values you get an analytical result — a formula that can be analyzed, simplified, or substituted into further expressions.",
                                "format_id": "193a841a-3f3b-44c3-b14b-1a252da5a042"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "This approach avoids rounding errors at every step of computation. The result remains mathematically exact throughout the work, and the transition to a decimal number occurs only at your request and with the precision you specify.",
                                "format_id": "a1e148dd-1cc5-4565-a22f-966a695e2340"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "In Yutovo, symbolic computations are implemented based on the SymEngine library. You can perform calculations in three areas: with real numbers, with exact rational fractions, and with complex numbers using the imaginary unit.",
                                "format_id": "a1e148dd-1cc5-4565-a22f-966a695e2340"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Currently, the following symbolic operations are supported: ",
                                "format_id": "a1e148dd-1cc5-4565-a22f-966a695e2340"
                            },
                            {
                                "id": "0,3,0,1",
                                "type": 39,
                                "level": 1,
                                "elements": "simplification",
                                "format_id": "780404af-7b15-4d77-ba74-bc95954d4090",
                                "url": "./Simplification.yut"
                            },
                            {
                                "id": "0,3,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": ", ",
                                "format_id": "a1e148dd-1cc5-4565-a22f-966a695e2340"
                            },
