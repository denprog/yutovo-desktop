                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "If an expression depends on some variable or function, it would be convenient to automatically recalculate this expression when it (the variable or function) changes. Yutovo allows you to do this. Dependent expressions are recalculated automatically after a specified time.",
                                "format_id": "a95c7e55-5a28-40a7-a9ae-95c8613c1eff"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
