mp_obj_t mp_obj_new_complex_real(double a,double b){
  if (b==0)
    return mp_obj_new_float(a);
  return mp_obj_new_complex(a,b);
}

static mp_obj_t linalg_addsub(size_t n_args, const mp_obj_t *args,_Bool add) {
  c_complex *x,*y;
  size_t n1,m1,n2,m2;
  if (mp_array2c_complextab(args[0],&x,&n1,&m1)){
    if (!mp_array2c_complextab(args[1],&y,&n2,&m2)){
      free(x);
      nlr_jump(((void*)mp_obj_new_exception_msg(&mp_type_ValueError, "Wrong type of 2nd argument.")));
    }
    if (n1!=n2 || m1!=m2){
      free(x); free(y);
      raisedimerr();
    }
    c_complex *x_=x,*y_=y;
    mp_obj_t res = mp_obj_new_list(0, ((void*)0));
    for (int i=0;i<n1;++i){
      if (m1==0){
 if (add)
   mp_obj_list_append(res,mp_obj_new_complex_real(x->r+y->r,x->i+y->i));
 else
   mp_obj_list_append(res,mp_obj_new_complex_real(x->r-y->r,x->i-y->i));
 ++x; ++y;
 continue;
      }
      mp_obj_t line = mp_obj_new_list(0, ((void*)0));
      if (add){
 for (int j=0;j<m1;++j,++x,++y){
   mp_obj_list_append(line,mp_obj_new_complex_real(x->r+y->r,x->i+y->i));
 }
      }
      else {
 for (int j=0;j<m1;++j,++x,++y){
   mp_obj_list_append(line,mp_obj_new_complex_real(x->r-y->r,x->i-y->i));
 }
      }
      mp_obj_list_append(res,line);
    }
    free(x_); free(y_);
    return res;
  }
  nlr_jump(((void*)mp_obj_new_exception_msg(&mp_type_ValueError, "Wrong type of 1st argument.")));
}
static mp_obj_t linalg_add(size_t n_args, const mp_obj_t *args) {
  return linalg_addsub(n_args,args,1);
}
