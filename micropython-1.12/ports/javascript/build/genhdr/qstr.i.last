static int
recursiveloop(char *pc, const char *sp, Subject *input, const char **subp, int nsubp)
{
 const char *old;
 int off;

                  ;

 for(;;) {
  if(((*pc) < ASSERTS)) {

   if(sp >= input->end)
    return 0;
  }
  switch(*pc++) {
  case Char:
   if(*sp != *pc++)
    return 0;
  case Any:
   sp++;
   continue;
  case Class:
  case ClassNot:
