ndarray_obj_t *ndarray_from_mp_obj(mp_obj_t obj, uint8_t other_type) {



    ndarray_obj_t *ndarray;

    if((mp_obj_is_small_int(obj) || (mp_obj_is_obj(obj) && (((mp_obj_base_t*)((void*)obj))->type == (&mp_type_int))))) {
        int32_t ivalue = mp_obj_get_int(obj);
        if((ivalue < -32767) || (ivalue > 32767)) {

            ndarray = ndarray_new_linear_array(1, NDARRAY_FLOAT);
            mp_float_t *array = (mp_float_t *)ndarray->array;
            array[0] = (mp_float_t)ivalue;
        } else {
            uint8_t dtype;
            if(ivalue < 0) {
                if(ivalue > -128) {
                    dtype = NDARRAY_INT8;
                } else {
                    dtype = NDARRAY_INT16;
                }
            } else {
                if((other_type == NDARRAY_INT8) || (other_type == NDARRAY_INT16)) {
                    if(ivalue < 128) {
                        dtype = NDARRAY_INT8;
                    } else {
                        dtype = NDARRAY_INT16;
                    }
                } else {
                    if(ivalue < 256) {
                        dtype = NDARRAY_UINT8;
                    } else {
                        dtype = NDARRAY_UINT16;
                    }
                }
            }
            ndarray = ndarray_new_linear_array(1, dtype);
            mp_binary_set_val_array(dtype, ndarray->array, 0, obj);
        }
    } else if((mp_obj_is_obj((obj)) && (((mp_obj_base_t*)((void*)(obj)))->type == (&mp_type_float)))) {
        ndarray = ndarray_new_linear_array(1, NDARRAY_FLOAT);
        mp_float_t *array = (mp_float_t *)ndarray->array;
        array[0] = mp_obj_get_float(obj);
    } else if((mp_obj_is_obj(obj) && (((mp_obj_base_t*)((void*)obj))->type == (&ulab_ndarray_type)))){
        return obj;
    } else {

        ndarray = ndarray_from_iterable(obj, NDARRAY_FLOAT);
    }
    return ndarray;
}


