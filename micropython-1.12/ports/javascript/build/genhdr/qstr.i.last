        (void)0;
        pns = (mp_parse_node_struct_t*)pns->nodes[0];
        (void)0;
        if (((pns->nodes[1]) != (0) && ((pns->nodes[1]) & 3) == 0)) {
            mp_parse_node_struct_t *pns2 = (mp_parse_node_struct_t*)pns->nodes[1];
            if (((pns2)->kind_num_nodes & 0xff) == PN_testlist_comp_3b) {

