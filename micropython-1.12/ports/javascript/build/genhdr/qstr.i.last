 mp_obj_t l = mp_obj_new_list(0, ((void*)0));
 for (int j=0;j<m1;++j){
   mp_obj_list_append(l,mp_obj_new_float(k<N?x[k]:0));
   ++k;
 }
 mp_obj_list_append(r,l);
