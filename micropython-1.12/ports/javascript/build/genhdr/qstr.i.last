static mp_obj_t linalg_cholesky(mp_obj_t oin) {
    ndarray_obj_t *ndarray = tools_object_is_square(oin);
    ndarray_obj_t *L = ndarray_new_dense_ndarray(2, ndarray_shape_vector(0, 0, ndarray->shape[2 - 1], ndarray->shape[2 - 1]), NDARRAY_FLOAT);
    mp_float_t *Larray = (mp_float_t *)L->array;

    size_t N = ndarray->shape[2 - 1];
    uint8_t *array = (uint8_t *)ndarray->array;
    mp_float_t (*func)(void *) = ndarray_get_float_function(ndarray->dtype);

    for(size_t m=0; m < N; m++) {
        for(size_t n=0; n < N; n++) {
            *Larray++ = func(array);
            array += ndarray->strides[2 - 1];
        }
        array -= ndarray->strides[2 - 1] * N;
        array += ndarray->strides[2 - 2];
    }
    Larray -= N*N;

    for(size_t m=0; m < N; m++) {
        for(size_t n=m+1; n < N; n++) {

            if(2.3e-16 < fabs(Larray[m * N + n] - Larray[n * N + m])) {
                mp_raise_ValueError("input matrix is asymmetric");
            }
        }
    }


    for(size_t i=0; i < N; i++) {
        for(size_t j=i+1; j < N; j++) {
            Larray[i*N + j] = 0.0;
        }
    }
    mp_float_t sum = 0.0;
    for(size_t i=0; i < N; i++) {
        for(size_t j=0; j <= i; j++) {
            sum = Larray[i * N + j];
            for(size_t k=0; k < j; k++) {
                sum -= Larray[i * N + k] * Larray[j * N + k];
            }
            if(i == j) {
                if(sum <= 0.0) {
                    mp_raise_ValueError("matrix is not positive definite");
                } else {
                    Larray[i * N + i] = sqrt(sum);
                }
            } else {
                Larray[i * N + j] = sum / Larray[j * N + j];
            }
        }
    }
    return ((mp_obj_t)L);
}

