enum FFT_TYPE {
    FFT_FFT,
    FFT_IFFT,
    FFT_SPECTROGRAM,
};

void fft_kernel(mp_float_t *, mp_float_t *, size_t , int );
mp_obj_t fft_fft_ifft_spectrogram(size_t , mp_obj_t , mp_obj_t , uint8_t );
# 17 "ulab/numpy/fft/fft_tools.c" 2
# 34 "ulab/numpy/fft/fft_tools.c"
void fft_kernel(mp_float_t *real, mp_float_t *imag, size_t n, int isign) {
    size_t j, m, mmax, istep;
    mp_float_t tempr, tempi;
    mp_float_t wtemp, wr, wpr, wpi, wi, theta;

    j = 0;
    for(size_t i = 0; i < n; i++) {
        if (j > i) {
            { mp_float_t tmp = real[i]; real[i] = real[j]; real[j] = tmp; };
            { mp_float_t tmp = imag[i]; imag[i] = imag[j]; imag[j] = tmp; };
        }
        m = n >> 1;
        while (j >= m && m > 0) {
            j -= m;
            m >>= 1;
        }
        j += m;
    }

    mmax = 1;
    while (n > mmax) {
        istep = mmax << 1;
        theta = -2.0*isign*3.14159265358979323846/istep;
        wtemp = sin(0.5 * theta);
        wpr = -2.0 * wtemp * wtemp;
        wpi = sin(theta);
        wr = 1.0;
        wi = 0.0;
        for(m = 0; m < mmax; m++) {
            for(size_t i = m; i < n; i += istep) {
                j = i + mmax;
                tempr = wr * real[j] - wi * imag[j];
                tempi = wr * imag[j] + wi * real[j];
                real[j] = real[i] - tempr;
                imag[j] = imag[i] - tempi;
                real[i] += tempr;
                imag[i] += tempi;
            }
            wtemp = wr;
            wr = wr*wpr - wi*wpi + wr;
            wi = wi*wpr + wtemp*wpi + wi;
        }
        mmax = istep;
    }
}







mp_obj_t fft_fft_ifft_spectrogram(size_t n_args, mp_obj_t arg_re, mp_obj_t arg_im, uint8_t type) {
    if(!(mp_obj_is_obj(arg_re) && (((mp_obj_base_t*)((void*)arg_re))->type == (&ulab_ndarray_type)))) {
        mp_raise_NotImplementedError("FFT is defined for ndarrays only");
    }
    if(n_args == 2) {
        if(!(mp_obj_is_obj(arg_im) && (((mp_obj_base_t*)((void*)arg_im))->type == (&ulab_ndarray_type)))) {
            mp_raise_NotImplementedError("FFT is defined for ndarrays only");
        }
    }
    ndarray_obj_t *re = ((void*)arg_re);

    if(re->ndim != 1) {
        mp_raise_TypeError("FFT is implemented for linear arrays only");
    }

    size_t len = re->len;

    if((len & (len-1)) != 0) {
        mp_raise_ValueError("input array length must be power of 2");
    }

    ndarray_obj_t *out_re = ndarray_new_linear_array(len, NDARRAY_FLOAT);
    mp_float_t *data_re = (mp_float_t *)out_re->array;

    uint8_t *array = (uint8_t *)re->array;
    mp_float_t (*func)(void *) = ndarray_get_float_function(re->dtype);

    for(size_t i=0; i < len; i++) {
        *data_re++ = func(array);
        array += re->strides[2 - 1];
    }
    data_re -= len;
    ndarray_obj_t *out_im = ndarray_new_linear_array(len, NDARRAY_FLOAT);
    mp_float_t *data_im = (mp_float_t *)out_im->array;

    if(n_args == 2) {
        ndarray_obj_t *im = ((void*)arg_im);

        if(im->ndim != 1) {
            mp_raise_TypeError("FFT is implemented for linear arrays only");
        }

        if (re->len != im->len) {
            mp_raise_ValueError("real and imaginary parts must be of equal length");
        }
        array = (uint8_t *)im->array;
        func = ndarray_get_float_function(im->dtype);
        for(size_t i=0; i < len; i++) {
           *data_im++ = func(array);
           array += im->strides[2 - 1];
        }
        data_im -= len;
    }

    if((type == FFT_FFT) || (type == FFT_SPECTROGRAM)) {
        fft_kernel(data_re, data_im, len, 1);
        if(type == FFT_SPECTROGRAM) {
            for(size_t i=0; i < len; i++) {
                *data_re = sqrt(*data_re * *data_re + *data_im * *data_im);
                data_re++;
                data_im++;
            }
        }
    } else {
        fft_kernel(data_re, data_im, len, -1);

        for(size_t i=0; i < len; i++) {
            *data_re++ /= len;
            *data_im++ /= len;
        }
    }
    if(type == FFT_SPECTROGRAM) {
        return ((void*)out_re);
    } else {
        mp_obj_t tuple[2];
        tuple[0] = out_re;
        tuple[1] = out_im;
        return mp_obj_new_tuple(2, tuple);
    }
}
