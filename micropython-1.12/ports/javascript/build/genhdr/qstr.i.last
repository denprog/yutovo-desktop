      for (int i=0;i<n1;++i){
 mp_obj_list_append(r,mp_obj_new_float(k<N?x[k]:0));
 ++k;
      }
      free(x);
      return r;
    }
    free(x);
  }
  if (n_args==2 && mp_obj_is_small_int(args[0])){
    int n1=(((mp_int_t)(args[0])) >> 1);
    mp_obj_t r = mp_obj_new_list(0, ((void*)0));
