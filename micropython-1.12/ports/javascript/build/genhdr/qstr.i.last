static mp_obj_t numerical_function(size_t n_args, const mp_obj_t *pos_args, mp_map_t *kw_args, uint8_t optype) {
    static const mp_arg_t allowed_args[] = {
        { MP_QSTR_, MP_ARG_REQUIRED | MP_ARG_OBJ, { .u_rom_obj = (((mp_obj_t)&mp_const_none_obj))} } ,
        { MP_QSTR_axis, MP_ARG_OBJ, { .u_rom_obj = (((mp_obj_t)&mp_const_none_obj)) } },
    };

    mp_arg_val_t args[(sizeof(allowed_args) / sizeof((allowed_args)[0]))];
    mp_arg_parse_all(n_args, pos_args, kw_args, (sizeof(allowed_args) / sizeof((allowed_args)[0])), allowed_args, args);

    mp_obj_t oin = args[0].u_obj;
    mp_obj_t axis = args[1].u_obj;
    if((axis != (((mp_obj_t)&mp_const_none_obj))) && (!(mp_obj_is_small_int(axis) || (mp_obj_is_obj(axis) && (((mp_obj_base_t*)((void*)axis))->type == (&mp_type_int)))))) {
        mp_raise_TypeError("axis must be None, or an integer");
    }

    if((optype == NUMERICAL_ALL) || (optype == NUMERICAL_ANY)) {
        return numerical_all_any(oin, axis, optype);
    }
    if((mp_obj_is_obj(oin) && (((mp_obj_base_t*)((void*)oin))->type == (&mp_type_tuple))) || (mp_obj_is_obj(oin) && (((mp_obj_base_t*)((void*)oin))->type == (&mp_type_list))) ||
        (mp_obj_is_obj(oin) && (((mp_obj_base_t*)((void*)oin))->type == (&mp_type_range)))) {
        switch(optype) {
            case NUMERICAL_MIN:
            case NUMERICAL_ARGMIN:
            case NUMERICAL_MAX:
            case NUMERICAL_ARGMAX:
                return numerical_argmin_argmax_iterable(oin, optype);
            case NUMERICAL_SUM:
            case NUMERICAL_MEAN:
                return numerical_sum_mean_std_iterable(oin, optype, 0);
            default:
                return (((mp_obj_t)&mp_const_none_obj));
        }
    } else if((mp_obj_is_obj(oin) && (((mp_obj_base_t*)((void*)oin))->type == (&ulab_ndarray_type)))) {
        ndarray_obj_t *ndarray = ((void*)oin);
        switch(optype) {
            case NUMERICAL_MIN:
            case NUMERICAL_MAX:
            case NUMERICAL_ARGMIN:
            case NUMERICAL_ARGMAX:
                return numerical_argmin_argmax_ndarray(ndarray, axis, optype);
            case NUMERICAL_SUM:
            case NUMERICAL_MEAN:
                return numerical_sum_mean_std_ndarray(ndarray, axis, optype, 0);
            default:
                mp_raise_NotImplementedError("operation is not implemented on ndarrays");
        }
    } else {
        mp_raise_TypeError("input must be tuple, list, range, or ndarray");
    }
    return (((mp_obj_t)&mp_const_none_obj));
}


