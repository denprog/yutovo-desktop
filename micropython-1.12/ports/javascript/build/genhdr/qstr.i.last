static mp_obj_t zip_make_new(const mp_obj_type_t *type, size_t n_args, size_t n_kw, const mp_obj_t *args) {
    mp_arg_check_num(n_args, n_kw, 0, (0xffff), 0);

    mp_obj_zip_t *o = ((mp_obj_zip_t*)m_malloc(sizeof(mp_obj_zip_t) + sizeof(mp_obj_t) * (n_args)));
    o->base.type = type;
    o->n_iters = n_args;
    for (size_t i = 0; i < n_args; i++) {
        o->iters[i] = mp_getiter(args[i], ((void*)0));
    }
    return ((mp_obj_t)o);
}

static mp_obj_t zip_iternext(mp_obj_t self_in) {
                                                        ;
    mp_obj_zip_t *self = ((void*)self_in);
    if (self->n_iters == 0) {
        return (((mp_obj_t)(void*)0));
    }
    mp_obj_tuple_t *tuple = ((void*)mp_obj_new_tuple(self->n_iters, ((void*)0)));

    for (size_t i = 0; i < self->n_iters; i++) {
        mp_obj_t next = mp_iternext(self->iters[i]);
        if (next == (((mp_obj_t)(void*)0))) {
            mp_obj_tuple_del(((mp_obj_t)tuple));
            return (((mp_obj_t)(void*)0));
        }
        tuple->items[i] = next;
    }
    return ((mp_obj_t)tuple);
}

