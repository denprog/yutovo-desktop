        { MP_QSTR_, MP_ARG_REQUIRED | MP_ARG_OBJ, {.u_rom_obj = (((mp_obj_t)&mp_const_none_obj)) } },
        { MP_QSTR_, MP_ARG_REQUIRED | MP_ARG_OBJ, {.u_rom_obj = (((mp_obj_t)&mp_const_none_obj)) } },
        { MP_QSTR_, MP_ARG_REQUIRED | MP_ARG_OBJ, {.u_rom_obj = (((mp_obj_t)&mp_const_none_obj)) } },
        { MP_QSTR_left, MP_ARG_KW_ONLY | MP_ARG_OBJ, {.u_rom_obj = (((mp_obj_t)&mp_const_none_obj))} },
        { MP_QSTR_right, MP_ARG_KW_ONLY | MP_ARG_OBJ, {.u_rom_obj = (((mp_obj_t)&mp_const_none_obj))} },
    };
    mp_arg_val_t args[(sizeof(allowed_args) / sizeof((allowed_args)[0]))];
    mp_arg_parse_all(n_args, pos_args, kw_args, (sizeof(allowed_args) / sizeof((allowed_args)[0])), allowed_args, args);

    ndarray_obj_t *x = ndarray_from_mp_obj(args[0].u_obj, 0);
    ndarray_obj_t *xp = ndarray_from_mp_obj(args[1].u_obj, 0);
    ndarray_obj_t *fp = ndarray_from_mp_obj(args[2].u_obj, 0);
    if((xp->ndim != 1) || (fp->ndim != 1) || (xp->len < 2) || (fp->len < 2) || (xp->len != fp->len)) {
        mp_raise_ValueError("interp is defined for 1D iterables of equal length");
    }

    ndarray_obj_t *y = ndarray_new_linear_array(x->len, NDARRAY_FLOAT);
    mp_float_t left_value, right_value;
    uint8_t *xparray = (uint8_t *)xp->array;

    mp_float_t xp_left = ndarray_get_float_value(xparray, xp->dtype);
    xparray += (xp->len-1) * xp->strides[2 - 1];
    mp_float_t xp_right = ndarray_get_float_value(xparray, xp->dtype);

    uint8_t *fparray = (uint8_t *)fp->array;

    if(args[3].u_obj == (((mp_obj_t)&mp_const_none_obj))) {
        left_value = ndarray_get_float_value(fparray, fp->dtype);
    } else {
