    }
    if(args[4].u_obj == (((mp_obj_t)&mp_const_none_obj))) {
        fparray += (fp->len-1) * fp->strides[2 - 1];
        right_value = ndarray_get_float_value(fparray, fp->dtype);
    } else {
        right_value = mp_obj_get_float(args[4].u_obj);
    }

    xparray = xp->array;
    fparray = fp->array;

