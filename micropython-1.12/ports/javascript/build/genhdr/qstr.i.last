double c_abs(c_complex c){
  double x=c.r<0?-c.r:c.r;
  double y=c.i<0?-c.i:c.i;
  if (x>y){
    double t=x;
    x=y;
    y=t;
  }

  if (y==0) return 0;
  double t=x/y;
  return y*sqrt(1+t*t);
}
