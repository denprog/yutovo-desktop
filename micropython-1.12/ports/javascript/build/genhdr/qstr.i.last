static mp_obj_t cho_solve(mp_obj_t _L, mp_obj_t _b) {

    if(!(mp_obj_is_obj(_L) && (((mp_obj_base_t*)((void*)_L))->type == (&ulab_ndarray_type))) || !(mp_obj_is_obj(_b) && (((mp_obj_base_t*)((void*)_b))->type == (&ulab_ndarray_type)))) {
