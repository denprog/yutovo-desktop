 for (int i=0;i<n1;++i,++x_,++y_){
   c.r += x_->r*y_->r-x_->i*y_->i;
   c.i += x_->r*y_->i+x_->i*y_->r;
 }
 free(x);free(y);
 return mp_obj_new_complex_real(c.r,c.i);
