typedef struct _mp_reader_posix_t {
    _Bool close_fd;
    int fd;
    size_t len;
    size_t pos;
    byte buf[20];
} mp_reader_posix_t;

static mp_uint_t mp_reader_posix_readbyte(void *data) {
    mp_reader_posix_t *reader = (mp_reader_posix_t*)data;
    if (reader->pos >= reader->len) {
        if (reader->len == 0) {
            return ((mp_uint_t)(-1));
        } else {
            int n = read(reader->fd, reader->buf, sizeof(reader->buf));
            if (n <= 0) {
                reader->len = 0;
                return ((mp_uint_t)(-1));
            }
            reader->len = n;
            reader->pos = 0;
        }
    }
    return reader->buf[reader->pos++];
}

static void mp_reader_posix_close(void *data) {
    mp_reader_posix_t *reader = (mp_reader_posix_t*)data;
    if (reader->close_fd) {
        close(reader->fd);
    }
    (((void)(1), m_free(reader)));
}




void mp_reader_new_file_from_fd(mp_reader_t *reader, int fd, _Bool close_fd) {
    mp_reader_posix_t *rp = (((mp_reader_posix_t*)(m_malloc(sizeof(mp_reader_posix_t) * (1)))));
    rp->close_fd = close_fd;
    rp->fd = fd;
    int n = read(rp->fd, rp->buf, sizeof(rp->buf));
    if (n == -1) {
        if (close_fd) {
            close(fd);
        }
        mp_raise_OSError(0);
    }
    rp->len = n;
    rp->pos = 0;
    reader->data = rp;
    reader->readbyte = mp_reader_posix_readbyte;
    reader->close = mp_reader_posix_close;
}



void mp_reader_new_file(mp_reader_t *reader, const char *filename) {
    int fd = open(filename, 00, 0644);
    if (fd < 0) {
        mp_raise_OSError(0);
    }
    mp_reader_new_file_from_fd(reader, fd, 1);
}
