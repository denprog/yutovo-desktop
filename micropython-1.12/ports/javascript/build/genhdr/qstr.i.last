        { MP_QSTR_, MP_ARG_REQUIRED | MP_ARG_OBJ, { .u_rom_obj = (((mp_obj_t)&mp_const_none_obj)) } },
        { MP_QSTR_, MP_ARG_REQUIRED | MP_ARG_OBJ, { .u_rom_obj = (((mp_obj_t)&mp_const_none_obj)) } },
        { MP_QSTR_tol, MP_ARG_KW_ONLY | MP_ARG_OBJ, { .u_rom_obj = (&xtolerance) } },
        { MP_QSTR_rtol, MP_ARG_KW_ONLY | MP_ARG_OBJ, { .u_rom_obj = (&rtolerance) } },
        { MP_QSTR_maxiter, MP_ARG_KW_ONLY | MP_ARG_INT, { .u_int = 50 } },
    };

    mp_arg_val_t args[(sizeof(allowed_args) / sizeof((allowed_args)[0]))];
    mp_arg_parse_all(n_args, pos_args, kw_args, (sizeof(allowed_args) / sizeof((allowed_args)[0])), allowed_args, args);

    mp_obj_t fun = args[0].u_obj;
    const mp_obj_type_t *type = mp_obj_get_type(fun);
    if(type->call == ((void*)0)) {
        mp_raise_TypeError("first argument must be a function");
    }
    mp_float_t x = mp_obj_get_float(args[1].u_obj);
    mp_float_t tol = mp_obj_get_float(args[2].u_obj);
    mp_float_t rtol = mp_obj_get_float(args[3].u_obj);
    mp_float_t dx, df, fx;
