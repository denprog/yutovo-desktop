        mp_printf(&mp_sys_stdout_print, "%d", ndarray->strides[2 -1]);
    }
    mp_printf(&mp_sys_stdout_print, ")\n");
    mp_printf(&mp_sys_stdout_print, "itemsize: %d\n", ndarray->itemsize);
    mp_printf(&mp_sys_stdout_print, "data pointer: 0x%p\n", ndarray->array);
    mp_printf(&mp_sys_stdout_print, "type: ");
    if(ndarray->boolean) {
        mp_printf(&mp_sys_stdout_print, "bool\n");
    } else if(ndarray->dtype == NDARRAY_UINT8) {
        mp_printf(&mp_sys_stdout_print, "uint8\n");
    } else if(ndarray->dtype == NDARRAY_INT8) {
        mp_printf(&mp_sys_stdout_print, "int8\n");
    } else if(ndarray->dtype == NDARRAY_UINT16) {
        mp_printf(&mp_sys_stdout_print, "uint16\n");
    } else if(ndarray->dtype == NDARRAY_INT16) {
        mp_printf(&mp_sys_stdout_print, "int16\n");
    } else if(ndarray->dtype == NDARRAY_FLOAT) {
        mp_printf(&mp_sys_stdout_print, "float\n");
    }
    return (((mp_obj_t)&mp_const_none_obj));
}

const mp_obj_fun_builtin_fixed_t ndarray_info_obj = {{&mp_type_fun_builtin_1}, .fun._1 = ndarray_info};



mp_int_t ndarray_get_buffer(mp_obj_t self_in, mp_buffer_info_t *bufinfo, mp_uint_t flags) {
    ndarray_obj_t *self = ((void*)self_in);
    if(!ndarray_is_dense(self)) {
        return 1;
    }
    bufinfo->len = self->itemsize * self->len;
    bufinfo->buf = self->array;
    bufinfo->typecode = self->dtype;
    return 0;
}
