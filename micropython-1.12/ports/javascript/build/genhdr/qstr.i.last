    uint8_t *L_ptr = L_arr;
    uint8_t *L_t_ptr = L_t_arr;
    for (i = 0; i < L_rows; i++) {
        for (j = 0; j < L_cols; j++) {
            set_L_ele(L_t_ptr, get_L_ele(L_ptr));
            L_t_ptr += L_t->strides[2 - 2];
            L_ptr += L->strides[2 - 1];
        }

        L_t_ptr -= j * L_t->strides[2 - 2];
        L_t_ptr += L_t->strides[2 - 1];
        L_ptr -= j * L->strides[2 - 1];
        L_ptr += L->strides[2 - 2];
