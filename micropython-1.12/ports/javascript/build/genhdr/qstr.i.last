static void mp_help_print_info_about_object(mp_obj_t name_o, mp_obj_t value) {
    mp_print_str(&mp_sys_stdout_print, "  ");
    mp_obj_print(name_o, PRINT_STR);
    mp_print_str(&mp_sys_stdout_print, " -- ");
    mp_obj_print(value, PRINT_STR);
    mp_print_str(&mp_sys_stdout_print, "\n");
}


