    results->boolean = 1;
    uint8_t *array = (uint8_t *)results->array;
    uint8_t *larray = (uint8_t *)lhs->array;
    uint8_t *rarray = (uint8_t *)rhs->array;


    if(op == MP_BINARY_OP_EQUAL) {
        if(lhs->dtype == NDARRAY_UINT8) {
            if(rhs->dtype == NDARRAY_UINT8) {
                size_t k = 0; do { size_t l = 0; do { *(array)++ = *((uint8_t *)(larray)) == *((uint8_t *)(rarray)) ? 1 : 0; (larray) += (lstrides)[2 - 1]; (rarray) += (rstrides)[2 - 1]; l++; } while(l < (results)->shape[2 - 1]); (larray) -= (lstrides)[2 - 1] * (results)->shape[2 -1]; (larray) += (lstrides)[2 - 2]; (rarray) -= (rstrides)[2 - 1] * (results)->shape[2 -1]; (rarray) += (rstrides)[2 - 2]; k++; } while(k < (results)->shape[2 - 2]);;
