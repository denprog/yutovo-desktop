static mp_obj_t ndarray_get_slice(ndarray_obj_t *ndarray, mp_obj_t index, ndarray_obj_t *values) {
    if((mp_obj_is_obj(index) && (((mp_obj_base_t*)((void*)index))->type == (&ulab_ndarray_type)))) {
        ndarray_obj_t *nindex = ((void*)index);
        if((nindex->ndim > 1) || (nindex->boolean == 0)) {
            mp_raise_NotImplementedError("operation is implemented for 1D Boolean arrays only");
        }
        if(values == ((void*)0)) {
            return ndarray_from_boolean_index(ndarray, nindex);
        } else {
            ndarray_assign_from_boolean_index(ndarray, index, values);
        }
    }
    if((mp_obj_is_obj(index) && (((mp_obj_base_t*)((void*)index))->type == (&mp_type_tuple))) || (mp_obj_is_small_int(index) || (mp_obj_is_obj(index) && (((mp_obj_base_t*)((void*)index))->type == (&mp_type_int)))) || (mp_obj_is_obj(index) && (((mp_obj_base_t*)((void*)index))->type == (&mp_type_slice)))) {
        mp_obj_tuple_t *tuple;
        if((mp_obj_is_obj(index) && (((mp_obj_base_t*)((void*)index))->type == (&mp_type_tuple)))) {
            tuple = ((void*)index);
            if(tuple->len > ndarray->ndim) {
                mp_raise_msg(&mp_type_IndexError, "too many indices");
            }
        } else {
            mp_obj_t *items = ((mp_obj_t*)(m_malloc(sizeof(mp_obj_t) * (1))));
            items[0] = index;
            tuple = mp_obj_new_tuple(1, items);
        }
        ndarray_obj_t *view = ndarray_view_from_slices(ndarray, tuple);
        if(values == ((void*)0)) {

            if(view->ndim == 0) {
                return mp_binary_get_val_array(view->dtype, view->array, 0);
            } else {
                return ((mp_obj_t)view);
            }
        } else {
            ndarray_assign_view(view, values);
        }
    }
    return (((mp_obj_t)&mp_const_none_obj));
}

mp_obj_t ndarray_subscr(mp_obj_t self_in, mp_obj_t index, mp_obj_t value) {
    ndarray_obj_t *self = ((void*)self_in);

    if (value == (((mp_obj_t)(void*)4))) {
        return ndarray_get_slice(self, index, ((void*)0));
    } else {
        ndarray_obj_t *values = ndarray_from_mp_obj(value, 0);
        return ndarray_get_slice(self, index, values);
    }
    return (((mp_obj_t)&mp_const_none_obj));
}





