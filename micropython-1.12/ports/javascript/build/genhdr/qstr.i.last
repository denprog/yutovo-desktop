                A_arr += A->strides[2 - 1];
            }

            sum = (get_b_ele(b_arr) - sum) / (get_A_ele(A_arr));
            *x_arr = sum;

            x_arr -= j;
            A_arr -= A->strides[2 - 1] * j;
            A_arr += A->strides[2 - 2];
            b_arr += b->strides[2 - 1];
        }
    } else {





        A_arr += (A->strides[2 - 2] * A_rows);
        b_arr += (b->strides[2 - 1] * A_cols);
        x_arr += A_cols;

        for (i = A_rows - 1; i < A_rows; i--) {
            mp_float_t sum = 0.0;
            for (j = i + 1; j < A_cols; j++) {
                sum += (get_A_ele(A_arr) * (*x_arr++));
                A_arr += A->strides[2 - 1];
            }

            x_arr -= (j - i);
            A_arr -= (A->strides[2 - 1] * (j - i));
            b_arr -= b->strides[2 - 1];

            sum = (get_b_ele(b_arr) - sum) / get_A_ele(A_arr);
            *x_arr = sum;

            A_arr -= A->strides[2 - 2];
        }
    }

    return ((mp_obj_t)x);
}

