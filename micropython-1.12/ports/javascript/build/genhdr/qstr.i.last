        ndarray_obj_t *inarray = ((void*)args[1].u_obj);

        if(inarray->ndim > 1) {
            mp_raise_ValueError("input must be one-dimensional");
        }

        uint8_t *iarray = (uint8_t *)inarray->array;
        for(size_t i=0; i < lenx; i++) {
