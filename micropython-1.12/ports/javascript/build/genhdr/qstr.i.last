mp_obj_t transform_dot(mp_obj_t _m1, mp_obj_t _m2) {


    if(!(mp_obj_is_obj(_m1) && (((mp_obj_base_t*)((void*)_m1))->type == (&ulab_ndarray_type))) || !(mp_obj_is_obj(_m2) && (((mp_obj_base_t*)((void*)_m2))->type == (&ulab_ndarray_type)))) {
        mp_raise_TypeError("arguments must be ndarrays");
    }
    ndarray_obj_t *m1 = ((void*)_m1);
    ndarray_obj_t *m2 = ((void*)_m2);
    uint8_t *array1 = (uint8_t *)m1->array;
    uint8_t *array2 = (uint8_t *)m2->array;

    mp_float_t (*func1)(void *) = ndarray_get_float_function(m1->dtype);
    mp_float_t (*func2)(void *) = ndarray_get_float_function(m2->dtype);

    if(m1->shape[2 - 1] != m2->shape[2 - m2->ndim]) {
        mp_raise_ValueError("dimensions do not match");
    }
    uint8_t ndim = ((m1->ndim) < (m2->ndim) ? (m1->ndim) : (m2->ndim));
    size_t shape1 = m1->ndim == 2 ? m1->shape[2 - m1->ndim] : 1;
    size_t shape2 = m2->ndim == 2 ? m2->shape[2 - 1] : 1;

    size_t *shape = ((void*)0);
    if(ndim == 2) {
        shape = ndarray_shape_vector(0, 0, shape1, shape2);
    } else {
        shape = ndarray_shape_vector(0, 0, 0, shape1);
    }
    ndarray_obj_t *results = ndarray_new_dense_ndarray(ndim, shape, NDARRAY_FLOAT);
    mp_float_t *rarray = (mp_float_t *)results->array;

    for(size_t i=0; i < shape1; i++) {
        for(size_t j=0; j < shape2; j++) {
            mp_float_t dot = 0.0;
            for(size_t k=0; k < m1->shape[2 - 1]; k++) {

                dot += func1(array1) * func2(array2);
                array1 += m1->strides[2 - 1];
                array2 += m2->strides[2 - m2->ndim];
            }
            *rarray++ = dot;
            array1 -= m1->strides[2 - 1] * m1->shape[2 - 1];
            array2 -= m2->strides[2 - m2->ndim] * m2->shape[2 - m2->ndim];
            array2 += m2->strides[2 - 1];
        }
        array1 += m1->strides[2 - m1->ndim];
        array2 = m2->array;
    }
    if((m1->ndim * m2->ndim) == 1) {
        return mp_obj_new_float(*(--rarray));
    } else {
        return ((mp_obj_t)results);
    }
}

