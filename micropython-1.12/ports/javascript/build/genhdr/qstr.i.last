            } else if(rhs->dtype == NDARRAY_UINT16) {
                size_t k = 0; do { size_t l = 0; do { *(array)++ = *((uint8_t *)(larray)) == *((uint16_t *)(rarray)) ? 1 : 0; (larray) += (lstrides)[2 - 1]; (rarray) += (rstrides)[2 - 1]; l++; } while(l < (results)->shape[2 - 1]); (larray) -= (lstrides)[2 - 1] * (results)->shape[2 -1]; (larray) += (lstrides)[2 - 2]; (rarray) -= (rstrides)[2 - 1] * (results)->shape[2 -1]; (rarray) += (rstrides)[2 - 2]; k++; } while(k < (results)->shape[2 - 2]);;
