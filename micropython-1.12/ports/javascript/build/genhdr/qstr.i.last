        mp_obj_t len = mp_obj_len_maybe(arg);
        if (len != (((mp_obj_t)(void*)0))) {

            return len != ((mp_obj_t)((((mp_uint_t)(0)) << 1) | 1));
        } else {

            return 1;
        }
    }
}

_Bool mp_obj_is_callable(mp_obj_t o_in) {
    mp_call_fun_t call = mp_obj_get_type(o_in)->call;
