_Bool ndarray_can_broadcast(ndarray_obj_t *lhs, ndarray_obj_t *rhs, uint8_t *ndim, size_t *shape, int32_t *lstrides, int32_t *rstrides) {





    memset(lstrides, 0, sizeof(size_t)*2);
    memset(rstrides, 0, sizeof(size_t)*2);
    lstrides[2 - 1] = lhs->strides[2 - 1];
    rstrides[2 - 1] = rhs->strides[2 - 1];
    for(uint8_t i=2; i > 0; i--) {
        if((lhs->shape[i-1] == rhs->shape[i-1]) || (lhs->shape[i-1] == 0) || (lhs->shape[i-1] == 1) ||
        (rhs->shape[i-1] == 0) || (rhs->shape[i-1] == 1)) {
            shape[i-1] = ((lhs->shape[i-1]) > (rhs->shape[i-1]) ? (lhs->shape[i-1]) : (rhs->shape[i-1]));
            if(shape[i-1] > 0) (*ndim)++;
            if(lhs->shape[i-1] < 2) {
                lstrides[i-1] = 0;
            } else {
                lstrides[i-1] = lhs->strides[i-1];
            }
            if(rhs->shape[i-1] < 2) {
                rstrides[i-1] = 0;
            } else {
                rstrides[i-1] = rhs->strides[i-1];
            }
        } else {
            return 0;
        }
    }
    return 1;
}


_Bool ndarray_can_broadcast_inplace(ndarray_obj_t *lhs, ndarray_obj_t *rhs, int32_t *rstrides) {






    memset(rstrides, 0, sizeof(size_t)*2);
    rstrides[2 - 1] = rhs->strides[2 - 1];
    for(uint8_t i=2; i > 0; i--) {
        if((lhs->shape[i-1] == rhs->shape[i-1]) || (rhs->shape[i-1] == 0) || (rhs->shape[i-1] == 1)) {
            if(rhs->shape[i-1] < 2) {
                rstrides[i-1] = 0;
            } else {
                rstrides[i-1] = rhs->strides[i-1];
            }
        } else {
            return 0;
        }
    }
    return 1;
}



static size_t slice_length(mp_bound_slice_t slice) {
    ssize_t len, correction = 1;
    if(slice.step > 0) correction = -1;
    len = (ssize_t)(slice.stop - slice.start + (slice.step + correction)) / slice.step;
    if(len < 0) return 0;
    return (size_t)len;
}

static mp_bound_slice_t generate_slice(mp_int_t n, mp_obj_t index) {
    mp_bound_slice_t slice;
    if( (mp_obj_is_obj(index) && (((mp_obj_base_t*)((void*)index))->type == (&mp_type_slice)))) {
        mp_obj_slice_indices(index, n, &slice);
