                start = -1;
            } else {
                start = 0;
            }
        }
    } else if (indexes->step > 0 && (mp_uint_t)start > len) {
        start = len;
    } else if (indexes->step < 0 && (mp_uint_t)start >= len) {
        start = len - 1;
    }
    if (stop < 0) {
        stop = len + stop;
        if (stop < 0) {
            stop = -1;
        }
        if (indexes->step < 0) {
            stop += 1;
        }
    } else if ((mp_uint_t)stop > len) {
        stop = len;
    }


    if (indexes->step > 0 && start > stop) {
