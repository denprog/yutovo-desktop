unichar utf8_get_char(const byte *s) {
    unichar ord = *s++;
    if (!((ord) & 0x80)) return ord;
    ord &= 0x7F;
    for (unichar mask = 0x40; ord & mask; mask >>= 1) {
        ord &= ~mask;
    }
    while ((((*s) & 0xC0) == 0x80)) {
        ord = (ord << 6) | (*s++ & 0x3F);
    }
    return ord;
}

const byte *utf8_next_char(const byte *s) {
    ++s;
    while ((((*s) & 0xC0) == 0x80)) {
        ++s;
    }
    return s;
}

mp_uint_t utf8_ptr_to_index(const byte *s, const byte *ptr) {
    mp_uint_t i = 0;
    while (ptr > s) {
        if (!(((*--ptr) & 0xC0) == 0x80)) {
            i++;
        }
    }

    return i;
}

size_t utf8_charlen(const byte *str, size_t len) {
    size_t charlen = 0;
    for (const byte *top = str + len; str < top; ++str) {
        if (!(((*str) & 0xC0) == 0x80)) {
            ++charlen;
        }
    }
    return charlen;
}




_Bool unichar_isspace(unichar c) {
    return c < 128 && (attr[c] & (0x02)) != 0;
}

_Bool unichar_isalpha(unichar c) {
    return c < 128 && (attr[c] & (0x08)) != 0;
}







_Bool unichar_isdigit(unichar c) {
    return c < 128 && (attr[c] & (0x04)) != 0;
}

_Bool unichar_isxdigit(unichar c) {
    return c < 128 && (attr[c] & (0x40)) != 0;
}

_Bool unichar_isident(unichar c) {
    return c < 128 && ((attr[c] & ((0x08) | (0x04))) != 0 || c == '_');
}

_Bool unichar_isupper(unichar c) {
    return c < 128 && (attr[c] & (0x10)) != 0;
}

_Bool unichar_islower(unichar c) {
    return c < 128 && (attr[c] & (0x20)) != 0;
}

unichar unichar_tolower(unichar c) {
    if (unichar_isupper(c)) {
        return c + 0x20;
    }
    return c;
}

unichar unichar_toupper(unichar c) {
    if (unichar_islower(c)) {
        return c - 0x20;
    }
    return c;
}

mp_uint_t unichar_xdigit_value(unichar c) {

    mp_uint_t n = c - '0';
    if (n > 9) {
        n &= ~('a' - 'A');
        n -= ('A' - ('9' + 1));
    }
    return n;
}



_Bool utf8_check(const byte *p, size_t len) {
    uint8_t need = 0;
    const byte *end = p + len;
    for (; p < end; p++) {
        byte c = *p;
        if (need) {
            if ((((c) & 0xC0) == 0x80)) {
                need--;
            } else {

                return 0;
            }
        } else {
            if (c >= 0xc0) {
                if (c >= 0xf8) {

                    return 0;
                }
                need = (0xe5 >> ((c >> 3) & 0x6)) & 3;
            } else if (c >= 0x80) {

                return 0;
            }
        }
    }
    return need == 0;
}
