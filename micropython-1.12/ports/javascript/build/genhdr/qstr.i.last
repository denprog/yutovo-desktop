shape_strides tools_reduce_axes(ndarray_obj_t *ndarray, mp_obj_t axis) {




    if(!(mp_obj_is_small_int(axis) || (mp_obj_is_obj(axis) && (((mp_obj_base_t*)((void*)axis))->type == (&mp_type_int)))) & (axis != (((mp_obj_t)&mp_const_none_obj)))) {
        mp_raise_TypeError("axis must be None, or an integer");
    }
    shape_strides _shape_strides;

    size_t *shape = ((size_t*)(m_malloc(sizeof(size_t) * (2 + 1))));
    _shape_strides.shape = shape;
    int32_t *strides = ((int32_t*)(m_malloc(sizeof(int32_t) * (2 + 1))));
    _shape_strides.strides = strides;

    _shape_strides.increment = 0;

    _shape_strides.ndim = 0;

    memcpy(_shape_strides.shape, ndarray->shape, sizeof(size_t) * 2);
    memcpy(_shape_strides.strides, ndarray->strides, sizeof(int32_t) * 2);

    if(axis == (((mp_obj_t)&mp_const_none_obj))) {
        return _shape_strides;
    }

    uint8_t index = 2 - 1;

    if(axis != (((mp_obj_t)&mp_const_none_obj))) {
        int8_t ax = mp_obj_get_int(axis);
        if(ax < 0) ax += ndarray->ndim;
        if((ax < 0) || (ax > ndarray->ndim - 1)) {
            mp_raise_ValueError("index out of range");
        }
        index = 2 - ndarray->ndim + ax;
        _shape_strides.ndim = ndarray->ndim - 1;
    }


    _shape_strides.shape[0] = ndarray->shape[index];
    _shape_strides.strides[0] = ndarray->strides[index];
    for(uint8_t i = 0; i < index; i++) {

        _shape_strides.shape[i + 1] = ndarray->shape[i];
        _shape_strides.strides[i + 1] = ndarray->strides[i];
    }

    if(_shape_strides.ndim != 0) {
        _shape_strides.increment = 1;
    }

    return _shape_strides;
}



ndarray_obj_t *tools_object_is_square(mp_obj_t obj) {


    if(!(mp_obj_is_obj(obj) && (((mp_obj_base_t*)((void*)obj))->type == (&ulab_ndarray_type)))) {
        mp_raise_TypeError("size is defined for ndarrays only");
    }
    ndarray_obj_t *ndarray = ((void*)obj);
    if((ndarray->shape[2 - 1] != ndarray->shape[2 - 2]) || (ndarray->ndim != 2)) {
        mp_raise_ValueError("input must be square matrix");
    }
    return ndarray;
}
