        case MP_BINARY_OP_POWER:
        case MP_BINARY_OP_INPLACE_POWER: {





            mp_float_t abs1 = sqrt(lhs_real*lhs_real + lhs_imag*lhs_imag);
            if (abs1 == 0) {
                if (rhs_imag == 0 && rhs_real >= 0) {
