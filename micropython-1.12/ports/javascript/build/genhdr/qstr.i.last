    } else {
        for(uint8_t i=0; i < ndarray->ndim-1; i++) mp_printf(&mp_sys_stdout_print, "%d, ", ndarray->shape[i]);
        mp_printf(&mp_sys_stdout_print, "%d", ndarray->shape[2 -1]);
    }
