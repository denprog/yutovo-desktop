mp_obj_t filter_convolve(size_t n_args, const mp_obj_t *pos_args, mp_map_t *kw_args) {
    static const mp_arg_t allowed_args[] = {
        { MP_QSTR_a, MP_ARG_REQUIRED | MP_ARG_OBJ, {.u_rom_obj = (((mp_obj_t)&mp_const_none_obj)) } },
        { MP_QSTR_v, MP_ARG_REQUIRED | MP_ARG_OBJ, {.u_rom_obj = (((mp_obj_t)&mp_const_none_obj)) } },
    };

    mp_arg_val_t args[(sizeof(allowed_args) / sizeof((allowed_args)[0]))];
    mp_arg_parse_all(n_args, pos_args, kw_args, (sizeof(allowed_args) / sizeof((allowed_args)[0])), allowed_args, args);

    if(!(mp_obj_is_obj(args[0].u_obj) && (((mp_obj_base_t*)((void*)args[0].u_obj))->type == (&ulab_ndarray_type))) || !(mp_obj_is_obj(args[1].u_obj) && (((mp_obj_base_t*)((void*)args[1].u_obj))->type == (&ulab_ndarray_type)))) {
        mp_raise_TypeError("convolve arguments must be ndarrays");
    }

    ndarray_obj_t *a = ((void*)args[0].u_obj);
    ndarray_obj_t *c = ((void*)args[1].u_obj);


    if((a->ndim != 1) || (c->ndim != 1)) {
        mp_raise_TypeError("convolve arguments must be linear arrays");
    }

    size_t len_a = a->len;
    size_t len_c = c->len;
    if(len_a == 0 || len_c == 0) {
        mp_raise_TypeError("convolve arguments must not be empty");
    }

    int len = len_a + len_c - 1;
    ndarray_obj_t *out = ndarray_new_linear_array(len, NDARRAY_FLOAT);
    mp_float_t *outptr = (mp_float_t *)out->array;
    uint8_t *aarray = (uint8_t *)a->array;
    uint8_t *carray = (uint8_t *)c->array;

    int32_t off = len_c - 1;
    int32_t as = a->strides[2 - 1] / a->itemsize;
    int32_t cs = c->strides[2 - 1] / c->itemsize;

    for(int32_t k=-off; k < len-off; k++) {
        mp_float_t accum = (mp_float_t)0.0;
        int32_t top_n = ((len_c) < (len_a - k) ? (len_c) : (len_a - k));
        int32_t bot_n = ((-k) > (0) ? (-k) : (0));
        for(int32_t n=bot_n; n < top_n; n++) {
            int32_t idx_c = (len_c - n - 1) * cs;
            int32_t idx_a = (n + k) * as;
            mp_float_t ai = ndarray_get_float_index(aarray, a->dtype, idx_a);
            mp_float_t ci = ndarray_get_float_index(carray, c->dtype, idx_c);
            accum += ai * ci;
        }
        *outptr++ = accum;
    }

    return out;
}

