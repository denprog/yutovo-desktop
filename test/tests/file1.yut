    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Арифметика  (др.-греч. ἀριθμητική, arithmētikḗ — от ἀριθμός, arithmós ) — ",
                                "format_id": "ef2e3fcb-b4da-4dbe-8a3a-54d592878706"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "раздел математики, изучающий числа, их отношения и свойства. ",
                                "format_id": "ef2e3fcb-b4da-4dbe-8a3a-54d592878706"
                            }
                        ]
                    },
                    {
                        "id": "0,0,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,2,0",
                                "type": 4,
                                "elements": "Предметом арифметики является понятие числа (натуральные, целые, ",
                                "format_id": "ef2e3fcb-b4da-4dbe-8a3a-54d592878706"
                            }
                        ]
                    },
                    {
                        "id": "0,0,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,3,0",
                                "type": 4,
                                "elements": "рациональные, вещественные, комплексные числа) и его свойства. В ",
                                "format_id": "ef2e3fcb-b4da-4dbe-8a3a-54d592878706"
                            }
                        ]
                    },
                    {
                        "id": "0,0,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,4,0",
                                "type": 4,
                                "elements": "арифметике рассматриваются измерения, вычислительные операции ",
                                "format_id": "ef2e3fcb-b4da-4dbe-8a3a-54d592878706"
                            }
                        ]
                    },
                    {
                        "id": "0,0,5",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,5,0",
                                "type": 4,
                                "elements": "(сложение, вычитание, умножение, деление) и приёмы вычислений. ",
                                "format_id": "ef2e3fcb-b4da-4dbe-8a3a-54d592878706"
                            }
                        ]
                    },
                    {
                        "id": "0,0,6",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,6,0",
                                "type": 4,
                                "elements": "Изучением свойств отдельных целых чисел занимается высшая ",
                                "format_id": "ef2e3fcb-b4da-4dbe-8a3a-54d592878706"
                            }
                        ]
                    },
                    {
                        "id": "0,0,7",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,7,0",
                                "type": 4,
                                "elements": "арифметика, или теория чисел. Теоретическая арифметика уделяет ",
                                "format_id": "ef2e3fcb-b4da-4dbe-8a3a-54d592878706"
                            }
                        ]
                    },
                    {
                        "id": "0,0,8",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,8,0",
                                "type": 4,
                                "elements": "внимание определению и анализу понятия числа, в то время как ",
                                "format_id": "ef2e3fcb-b4da-4dbe-8a3a-54d592878706"
                            }
                        ]
                    },
                    {
                        "id": "0,0,9",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,9,0",
                                "type": 4,
                                "elements": "формальная арифметика оперирует логическими построениями предикатов ",
                                "format_id": "ef2e3fcb-b4da-4dbe-8a3a-54d592878706"
                            }
                        ]
                    },
                    {
                        "id": "0,0,10",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,10,0",
                                "type": 4,
                                "elements": "и аксиом. Арифметика является древнейшей и одной из  ых ",
                                "format_id": "ef2e3fcb-b4da-4dbe-8a3a-54d592878706"
                            }
                        ]
                    },
                    {
                        "id": "0,0,11",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,11,0",
                                "type": 4,
                                "elements": "математических наук; она тесно связана с алгеброй, геометрией и теорией ",
                                "format_id": "ef2e3fcb-b4da-4dbe-8a3a-54d592878706"
                            }
                        ]
                    },
                    {
                        "id": "0,0,12",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,12,0",
                                "type": 4,
                                "elements": "чисел[1][2].",
                                "format_id": "ef2e3fcb-b4da-4dbe-8a3a-54d592878706"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 1
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Причиной возникновения арифметики стала практическая потребность в ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "счёте и вычислениях, связанных с задачами учёта при централизации ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,1,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,2,0",
                                "type": 4,
                                "elements": "сельского хозяйства. Наука развивалась вместе с усложнением задач, ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,1,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,3,0",
                                "type": 4,
                                "elements": "требующих решения. Большой вклад в развитие арифметики внесли ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,1,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,4,0",
                                "type": 4,
                                "elements": "греческие математики — в частности, философы-пифагорейцы, ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,1,5",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,5,0",
                                "type": 4,
                                "elements": "пытавшиеся с помощью чисел постичь и описать все закономерности мира.",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "В Средние века арифметику относили, вслед за неоплатониками, к числу ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "так называемых семи свободных искусств. Основными областями ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,2,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,2,0",
                                "type": 4,
                                "elements": "практического применения арифметики тогда были торговля, навигация, ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,2,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,3,0",
                                "type": 4,
                                "elements": "строительство. В связи с этим особое значение получили приближённые ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,2,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,4,0",
                                "type": 4,
                                "elements": "вычисления иррациональных чисел, необходимые, в первую очередь, для ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,2,5",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,5,0",
                                "type": 4,
                                "elements": "геометрических построений. Особенно бурно арифметика развивалась в ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,2,6",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,6,0",
                                "type": 4,
                                "elements": "Индии и странах ислама, откуда новейшие достижения математической ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,2,7",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,7,0",
                                "type": 4,
                                "elements": "мысли проникли в Западную Европу; Россия знакомилась с ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,2,8",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,8,0",
                                "type": 4,
                                "elements": "математическими знаниями «и от греков, и от латин».",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "С наступлением Нового времени мореходная астрономия, механика, ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,3,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,1,0",
                                "type": 4,
                                "elements": "усложнившиеся коммерческие расчёты выдвинули новые требования к ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,3,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,2,0",
                                "type": 4,
                                "elements": "технике вычислений и дали толчок к дальнейшему развитию арифметики. В ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,3,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,3,0",
                                "type": 4,
                                "elements": "начале XVII века Непер изобрёл логарифмы, а затем Ферма выделил ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,3,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,4,0",
                                "type": 4,
                                "elements": "теорию чисел в самостоятельный раздел арифметики. К концу века ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,3,5",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,5,0",
                                "type": 4,
                                "elements": "сформировалось представление об иррациональном числе как о ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,3,6",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,6,0",
                                "type": 4,
                                "elements": "последовательности рациональных приближений, а в течение следующего ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,3,7",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,7,0",
                                "type": 4,
                                "elements": "столетия благодаря трудам Ламберта, Эйлера, Гаусса арифметика ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,3,8",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,8,0",
                                "type": 4,
                                "elements": "включила в себя операции с комплексными величинами, приобретя ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,3,9",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,9,0",
                                "type": 4,
                                "elements": "современный вид.",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "Последующая история арифметики ознаменована критическим ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,4,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,1,0",
                                "type": 4,
                                "elements": "пересмотром её основ, попытками дедуктивного её обоснования. ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,4,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,2,0",
                                "type": 4,
                                "elements": "Теоретические обоснования представления о числе связаны, в первую ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,4,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,3,0",
                                "type": 4,
                                "elements": "очередь, со строгим определением натурального числа и аксиомами ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,4,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,4,0",
                                "type": 4,
                                "elements": "Пеано, сформулированными в 1889 году. Непротиворечивость ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,4,5",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,5,0",
                                "type": 4,
                                "elements": "формального построения арифметики была показана Генценом в 1936 году.",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "elements": [
                    {
