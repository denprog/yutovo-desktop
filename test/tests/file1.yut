                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "Основам арифметики издавна и неизменно уделяется большое внимание в ",
                                "format_id": "7319a2b2-9713-473c-827b-1c6a036a2d39"
                            }
                        ]
                    },
                    {
                        "id": "0,5,1",
