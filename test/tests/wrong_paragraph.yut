    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Стандартная панель инструментов",
                                "format_id": "487901ec-7161-4565-a4af-41f29241ca5c"
                            }
                        ],
                        "format_name": "Заголовок 4"
                    }
                ],
                "format_name": "Заголовок 4",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": ""
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Предназначена для работы с файлами и для редактирования текста. Открытие, сохранение, скачивание, переименовывание и удаление файлов доступно только после логина. Кнопка \"Настройки\" ",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            },
                            {
                                "id": "0,2,0,1",
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,2,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": " предназначена для установки параметров вычисления выражений, языка документа и подключаемых документов. От языка документа зависит набор используемых встроенных переменных, функций и размерностей. Вы можете изменять масштаб документа с помощью элемента масштабирования: ",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            },
                            {
                                "id": "0,2,0,3",
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,2,0,4",
                                "type": 4,
                                "level": 1,
                                "elements": ". Также изменение масштаба возможно колесиком мыши с нажатой клавишей Ctrl. Кнопка \"Пересчитать документ\" ",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            },
                            {
                                "id": "0,2,0,5",
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,2,0,6",
                                "type": 4,
                                "level": 1,
                                "elements": " вызывает вычисление всех выражений в документе. Кнопки выбора формата параграфа, шрифта, его размера и стиля эквивалентны обычному редактору.",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
