                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "A função expand expande produtos, potências e parênteses em forma expandida. A função aplica identidades algébricas e transforma uma construção complexa em uma soma de termos individuais. O resultado é conveniente para analisar a composição da expressão e para transformações posteriores.",
                                "format_id": "9b9a0855-e6bd-4e35-8ae1-193af45bb041"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
