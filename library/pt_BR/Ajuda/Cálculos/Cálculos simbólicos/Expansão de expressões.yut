                            }
                        ],
                        "format_name": "Exemplo"
                    }
                ],
                "format_name": "Exemplo",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Binômio de Newton. A notação de potência oculta a estrutura. A expansão mostra todos os termos do binômio com coeficientes exatos:",
                                "format_id": "7df80276-61dd-4d20-b5a6-b29e8a3200ac"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
