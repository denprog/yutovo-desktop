            },
            {
                "id": "0,51",
                "type": 2,
                "elements": [
                    {
                        "id": "0,51,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,51,0,0",
                                "type": 4,
                                "elements": "Agora vamos extrair a raiz quadrada da expressão no denominador. Aqui novamente, a seleção ajudará. Agora o cursor está na posição mais à direita, então para selecionar o denominador, você precisa pressionar [Shift+Left] até que esta expressão esteja totalmente selecionada, ou [Shift+Home] para selecionar toda a linha. Em seguida, digite a operação de extração de raiz pressionando [Shift+Ctrl+Q].",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
                    },
                    {
                        "id": "0,51,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,51,1,0",
                                "type": 4,
                                "elements": "direita, então para selecionar o denominador, você precisa pressionar [Shift+Left] até que esta expressão esteja totalmente selecionada, ou [Shift+Home] para",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
                    },
                    {
                        "id": "0,51,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,51,2,0",
                                "type": 4,
                                "elements": "para selecionar toda a linha. Em seguida, digite a operação de extração de raiz pressionando [Shift+Ctrl+Q].",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
