                    {
                        "id": "0,50,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,50,0,0",
                                "type": 4,
                                "elements": "As linhas \"sin\" e \"cos\" são exibidas em uma cor diferente dos números. Isso é feito por conveniência.",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
