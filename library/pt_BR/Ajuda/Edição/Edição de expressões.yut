                    {
                        "id": "0,29,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,29,0,0",
                                "type": 4,
                                "elements": "Excluindo caracteres e operações",
                                "format_id": "08d9a63b-1219-44cf-941b-f5a3643005f5"
                            }
                        ]
                    }
                ],
                "format_name": "Cabeçalho 4",
                "format_alignment": 0
            },
            {
                "id": "0,30",
                "type": 2,
                "elements": [
                    {
                        "id": "0,30,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,30,0,0",
                                "type": 4,
                                "elements": "Os caracteres em uma linha são excluídos simplesmente, como é costume nos editores. Você precisa mover o cursor para o caractere desejado e pressionar [Del] se o caractere estiver à direita, ou [Backspace] se o caractere estiver à esquerda.",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
                    },
                    {
                        "id": "0,30,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,30,1,0",
                                "type": 4,
                                "elements": "pressionar [Del] se o caractere estiver à direita, ou [Backspace] se o caractere estiver à esquerda.",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
            {
                "id": "0,31",
                "type": 2,
                "elements": [
