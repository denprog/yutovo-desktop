                        "type": 3,
                        "elements": [
                            {
                                "id": "0,32,0,0",
                                "type": 4,
                                "elements": "No exemplo acima, excluiremos o último caractere da expressão radical. Para fazer isso, use as teclas de cursor ou o mouse para colocar o cursor no final da expressão radical e pressione [Del]:",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
                    },
