            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "• sair da conta;",
                                "format_id": "3afdab91-3cc0-4be0-9da7-df0a74fab15e"
                            }
                        ],
                        "format_name": "Corpo do texto"
