                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "• alterando o nome que foi inserido durante o registro (não o login - ele não pode ser alterado);",
                                "format_id": "3afdab91-3cc0-4be0-9da7-df0a74fab15e"
                            }
                        ],
                        "format_name": "Corpo do texto"
