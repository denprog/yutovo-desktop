                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Os usuários registrados no ",
                                "format_id": "bd9aabb8-9570-42bf-92a8-c8c1a57bc89d"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 39,
                                "elements": "site",
                                "format_id": "d338b315-a9b4-4a00-8a75-7f4d6e02c9b0",
                                "url": "https://yutovo.com"
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "elements": " têm acesso aos seguintes recursos após o login bem-sucedido, que estão localizados na caixa de diálogo que se abre ao clicar em \"Entrar\":",
                                "format_id": "bd9aabb8-9570-42bf-92a8-c8c1a57bc89d"
                            }
                        ],
                        "format_name": "Corpo do texto"
                    }
                ],
                "format_name": "Corpo do texto",
                "format_alignment": 0
            },
