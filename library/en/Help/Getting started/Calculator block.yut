    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "A calculator block is a rectangle in the text for performing calculations. It appears at the beginning of an empty document and then can be added anywhere in the document (except for the place inside another calculator block) using the \"Insert calculator\" button or the key combination [Ctrl+Shift+C]. A calculator block also appears when you start entering formulas using the math panel buttons, if the cursor is not in block at that moment.",
                                "format_id": "848cca29-bd4d-4661-88e0-760d37b864f5"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "There can be as many calculator blocks as you like and they form a single space for solving between themselves. This means, in particular, that variables and functions declared in the block above can be used in the block below.",
                                "format_id": "848cca29-bd4d-4661-88e0-760d37b864f5"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "These blocks can be copied to the clipboard like any other symbols. If a mathematical expression from a block is copied to text, a calculator block will automatically appear.",
                                "format_id": "848cca29-bd4d-4661-88e0-760d37b864f5"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "Text outside these blocks does not affect calculations in any way.",
                                "format_id": "848cca29-bd4d-4661-88e0-760d37b864f5"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
