            {
                "id": "0,42",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,42,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,42,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "This way, you can delete all possible operation symbols in the program.",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,43",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,43,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,43,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Entering operations using selection",
                                "format_id": "3c16f630-112c-4909-91ef-62ffe2b678d4"
                            }
                        ],
                        "format_name": "Example"
                    }
                ],
                "format_name": "Example",
                "format_alignment": 0
            },
            {
                "id": "0,44",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,44,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,44,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Operation parameters can use an expression containing other operations. To enter such operations, it is convenient to use the selection of parts of the formula.",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,45",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,45,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,45,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Example:",
                                "format_id": "3c16f630-112c-4909-91ef-62ffe2b678d4"
                            }
                        ],
                        "format_name": "Example"
                    }
                ],
                "format_name": "Example",
                "format_alignment": 0
            },
            {
                "id": "0,46",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,46,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,46,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Let's take the expression from the previous example and divide it by a number. To do this, first select it with the mouse or the cursor keys. Selection with the cursor keys is carried out by successively pressing [Shift+Up] or [Shift+Down] until the entire expression is selected. Then press \"/\" to enter the division operation.",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
