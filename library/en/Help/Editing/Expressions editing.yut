            {
                "id": "0,9",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "When entering a number (string), the cursor moves to the \"inside the string\" position and takes the form of the text cursor. The cursor can be moved to another position inside the string using the cursor keys. Press: [Left][Left][Left][Left][Left]. The cursor will move five characters to the left. Now the string will be entered in the new position. Enter: \"90\".",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,10",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "After entering new characters, the cursor has moved to a new location.",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
