    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Entering mathematical expressions is done by simply typing them on the keyboard, using hot keys or the math toolbar.",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Here is a short tutorial on editing.",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "At the beginning, an expression is represented by an empty line in a code block:",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 5,
                                "level": 1,
                                "elements": [
                                    {
                                        "id": "0,3,0,0,0",
                                        "type": 6,
                                        "level": 1,
                                        "elements": [
                                            {
                                                "id": "0,3,0,0,0,0",
                                                "type": 7,
                                                "level": 1,
                                                "elements": [
                                                    {
                                                        "id": "0,3,0,0,0,0,0",
                                                        "type": 8,
                                                        "level": 1,
                                                        "elements": "",
                                                        "format_id": "e254f8da-75d2-4960-80da-53bae4501b8b",
                                                        "can_merge": true
                                                    }
                                                ]
                                            }
                                        ],
                                        "format_name": "Code",
                                        "format_alignment": 0
                                    }
                                ],
                                "code_id": 1
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "The cursor keys allow you to move through the formulas. The left and right cursor (the [Left Arrow] and [Right Arrow] keys) moves sequentially from formula to formula. When moving up ([Up Arrow]) and down ([Down Arrow]), the cursor jumps to the nearest upper or lower element. The [Ctrl]-[Left Arrow] and [Ctrl]-[Right Arrow] keys can be used to move the cursor without entering nested elements. The [Home] key is used to move the cursor to a more common element, or to the beginning of the line.",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Example:",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "The following example will enter an expression from the very beginning, from an empty line.",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Enter the number: \"1234.5678\".",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "level": 1,
