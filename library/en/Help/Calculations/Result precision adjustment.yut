            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Firstly a result is calculated with the default precision specified in the document settings. The precision can be changed for each result later. This is done by right-clicking on the result and selecting \"Precision\". In the dialog that appears, select a precision between 1 and 100 and click OK. The expression will be recalculated with the new precision.",
                                "format_id": "e02ad5e8-8a84-4a4c-93f7-9ec88494e85e"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
