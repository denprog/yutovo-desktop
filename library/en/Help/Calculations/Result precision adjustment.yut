                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Changing precision of a result is possible only for real and complex numbers. Integer and rational numbers do not have a floating point.",
                                "format_id": "e02ad5e8-8a84-4a4c-93f7-9ec88494e85e"
                            }
                        ],
                        "format_name": "Text body"
                    }
