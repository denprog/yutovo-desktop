    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Yutovo contains a large number of built-in units. However, sometimes they are not enough. Custom units are formed from built-in ones by declaring them in the document. They are declared by the button ",
                                "format_id": "cf5daa11-a526-4b88-aa12-03e8df04e70e"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "elements": " or the \"~\" key.",
                                "format_id": "cf5daa11-a526-4b88-aa12-03e8df04e70e"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
