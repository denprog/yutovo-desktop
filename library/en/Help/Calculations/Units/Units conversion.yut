    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Yutovo can convert units from one system of units to another, and also present the result in other units of the same system.",
                                "format_id": "ebae72e0-8f0a-42e7-9c59-acf2582fbc06"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "The conversion of units within one system can occur automatically (if the unit is not specified explicitly) when calculating the result of an expression. To convert the result to another system, you must explicitly specify it.",
                                "format_id": "ebae72e0-8f0a-42e7-9c59-acf2582fbc06"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Automatic selection of a unit occurs when the result of an expression is calculated for the first time. The context menu of the calculation result is intended for selecting a specific unit and system of units. In this menu, the user selects the desired system of units and the unit to which he wants to convert the result.",
                                "format_id": "ebae72e0-8f0a-42e7-9c59-acf2582fbc06"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Simple units",
                                "format_id": "b6db0683-8d2f-473e-8fd0-d8629e224332"
                            }
                        ],
                        "format_name": "Header 4"
                    }
                ],
                "format_name": "Header 4",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Example:",
                                "format_id": "ffaf6ff7-d866-4d8e-a158-2514e08963ad"
                            }
                        ],
                        "format_name": "Example"
                    }
                ],
                "format_name": "Example",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "The following example uses length units. Since the system of units is not defined, the default metric system (SI) is used. The most appropriate unit is automatically selected during calculations. All units used in the example are built-in.",
                                "format_id": "ebae72e0-8f0a-42e7-9c59-acf2582fbc06"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
