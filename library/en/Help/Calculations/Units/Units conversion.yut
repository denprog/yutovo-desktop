            {
                "id": "0,20",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,20,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,20,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "The result unit in this case is meters per second. It turned out to be composite, since no unit equal to it was declared. Based on this unit and on the built-in units based on meters and seconds, various combinations can be made, which will be presented in the Units dialog. Select, for example, \"cm/s\".",
                                "format_id": "ebae72e0-8f0a-42e7-9c59-acf2582fbc06"
                            }
                        ],
                        "format_name": "Text body"
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
