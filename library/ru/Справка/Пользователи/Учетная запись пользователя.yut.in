                                "type": 4,
                                "level": 1,
                                "elements": " пользователям при успешном логине доступны следующие возможности, находящиеся в диалоге, вызываемом при клике на логине:",
                                "format_id": "846c7ced-52d5-4c34-890c-0ed2736b7ba7"
                            }
                        ],
                        "format_name": "Основной текст"
