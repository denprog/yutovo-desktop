    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Блок калькулятора - это прямоугольник в тексте для проведения вычислений. Он появляется в начале пустого документа и далее может быть добавлен в любом месте документа (кроме места внутри блока кода) с помощью кнопки \"Вставить калькулятор\" ",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 34,
                                "level": 1,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": " или комбинацией клавиш [Ctrl+Shift+C]. Также блок калькулятора появляется при начале ввода кода кнопками математической панели, если курсор в этот момент не находится в коде.",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Блоков калькулятора может быть сколько угодно и между собой они образуют единое пространство для вычислений. Это в частности означает, что переменные и функции, объявленные в блоке выше могут быть использованы в блоке ниже.",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Эти блоки можно копировать в буфер обмена как любые другие символы. Если математическое выражение из блока будет скопировано в текст, то автоматически возникнет новый блок калькулятора.",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Текст вне этих блоков никак не влияет на вычисления.",
                                "format_id": "5695a9fc-bfb2-400e-9cf7-a97c96761c88"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
