    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Ютово - это приложение для решения различных математических задач. Ютово имеет наглядный \"бумажный\" вид для вычислений. Оно использует общепризнанный математический синтаксис для отображения формул. Ютово предназначено для решения как повседневных, так и инженерных задач и подходит для широкого круга пользователей в самых разных сферах деятельности.",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Ютово использует графическое предствление математических формул.",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Результаты вычислений могут иметь любое количество цифр и ",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            },
                            {
                                "id": "0,2,0,1",
                                "type": 39,
                                "level": 1,
                                "elements": "точность",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Вычисления/Изменение точности результата.yut"
                            },
                            {
                                "id": "0,2,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": ".",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Ютово работает со следующими типами чисел: ",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            },
                            {
                                "id": "0,3,0,1",
