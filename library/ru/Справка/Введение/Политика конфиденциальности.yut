                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "1. Информация для сбора",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Мы можем собирать личную информацию пользователя, такую как имя, адрес электронной почты, IP-адрес и другую информацию.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "2. Способы сбора информации",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Мы можем собирать информацию, когда пользователь регистрируется, отменяет регистрацию, входит или выходит из системы на сайте.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Мы можем собирать личную информацию, когда пользователь использует любую из услуг сайта.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "3. Использование информации",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Мы можем использовать информацию для проверки вашей учетной записи на веб-сайте, отправив письмо с подтверждением на ваш зарегистрированный адрес электронной почты.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Мы можем использовать личную информацию для ответа на запросы пользователей. Мы можем использовать личную информацию для улучшения услуг, веб-сайта и настольного приложения. Мы можем использовать личную информацию в целях безопасности для защиты пользователей и веб-сайта. Мы можем использовать информацию, если это разрешено законом.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "4. Права пользователя на свои данные",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Вы можете потребовать, чтобы мы удалили любые личные данные, которые мы храним о вас. Сюда не входят данные, которые мы обязаны хранить в административных, юридических целях или целях безопасности. Отправить запрос на удаление данных можно на сайте support@yutovo.ru.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,10",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "5. Отказ от ответственности",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,11",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,11,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Вы принимаете на себя всю ответственность и риск в отношении использования вами веб-сайта, который предоставляется «как есть» без каких-либо гарантий. Информация, доступ к которой осуществляется с помощью веб-сайта, включая, помимо прочего, весь контент и материалы, а также функции и услуги, представленные на нашем веб-сайте, все они представляются без каких-либо гарантий, включая, помимо прочего, гарантии относительно доступности, точности, полноты или полезности контента или информации, бесперебойности доступа и любые гарантии прав собственности, ненарушения прав, коммерческой пригодности или пригодности для определенной цели. Мы не гарантируем, что наш веб-сайт или его функционирование, а также содержимое и материалы предоставляемых через него услуг будут своевременными, безопасными, бесперебойными и не содержать ошибок, что дефекты будут исправлены или что наши веб-сайты или серверы, обеспечивающие доступ к нашему веб-сайту, не содержат вирусов или другие вредные компоненты. Вы используете наш веб-сайт на свой страх и риск, и вы принимаете на себя полную ответственность за любые расходы, связанные с использование вами веб-сайта. Мы не несем ответственности за любой ущерб, связанный с использованием нашего веб-сайта.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
