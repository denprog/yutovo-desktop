    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Изменение меры угла возможно только для вещественных и комплексных чисел.",
                                "format_id": "5779858b-fefa-4044-bca9-d034ad7ce0a5"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Мера угла по умолчанию задается в настройках документа. Ее можно изменить из контекстного меню  ",
                                "format_id": "5779858b-fefa-4044-bca9-d034ad7ce0a5"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "результата выбором пункта \"Мера угла по умолчанию\".",
                                "format_id": "5779858b-fefa-4044-bca9-d034ad7ce0a5"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Пример:",
                                "format_id": "c4e163a0-e625-4822-b5a5-2f27d48b3cbe"
                            }
                        ]
                    }
                ],
                "format_name": "Пример",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "В следующем выражении по умолчанию в настройках стоит радианная мера угла. Поэтому синус вычисляется ",
                                "format_id": "5779858b-fefa-4044-bca9-d034ad7ce0a5"
                            }
                        ]
                    },
                    {
                        "id": "0,3,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,1,0",
                                "type": 4,
                                "elements": "от 2.5 радиан, а тангенс - от 5.34 градусов, поскольку эта мера явно указана.",
                                "format_id": "5779858b-fefa-4044-bca9-d034ad7ce0a5"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
