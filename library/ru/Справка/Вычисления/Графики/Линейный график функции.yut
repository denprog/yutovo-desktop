                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": " панели Графики, затем введите крайние точки осей, выражение функции для оси y и параметр оси x. Выражение для функции может быть любым в рамках принятого синтаксиса. Выражение для аргумента - любое имя переменной.",
                                "format_id": "60c7a8af-d45e-452e-b5e7-c9da4063f1a6"
                            }
                        ],
                        "format_name": "Основной текст"
