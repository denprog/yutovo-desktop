                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Для построения линейного графика функции кликните на кнопку ",
                                "format_id": "60c7a8af-d45e-452e-b5e7-c9da4063f1a6"
