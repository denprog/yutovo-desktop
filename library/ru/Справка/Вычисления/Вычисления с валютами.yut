    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "В данной версии приложения представлены следующие валюты: бразильский реал - R$, китайский ",
                                "format_id": "2328787c-9253-4369-a969-bf2b35390aac"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "юань - ¥, евро - €, индийская рупия - ₹, российский рубль - ₽, доллар США - $. Валюты для приложения ",
                                "format_id": "2328787c-9253-4369-a969-bf2b35390aac"
                            }
                        ]
                    },
                    {
                        "id": "0,0,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,2,0",
                                "type": 4,
                                "elements": "являются обычными размерностями и возможны любые математические операции в пределах каждой ",
                                "format_id": "2328787c-9253-4369-a969-bf2b35390aac"
                            }
                        ]
                    },
                    {
                        "id": "0,0,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,3,0",
                                "type": 4,
                                "elements": "из валют.",
                                "format_id": "2328787c-9253-4369-a969-bf2b35390aac"
                            }
                        ]
                    }
                ],
