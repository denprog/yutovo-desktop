    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Ютово содержит большое количество встроенных размерностей. Однако, иногда их не хватает. ",
                                "format_id": "fa94a7b6-8887-45a4-b28a-ed7dcdf6e8dc"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "Пользовательские размерности образуются из встроенных путем их объявления в документе. Их объявление ",
                                "format_id": "fa94a7b6-8887-45a4-b28a-ed7dcdf6e8dc"
                            }
                        ]
                    },
                    {
                        "id": "0,0,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,2,0",
                                "type": 4,
                                "elements": "производится кнопкой ",
                                "format_id": "fa94a7b6-8887-45a4-b28a-ed7dcdf6e8dc"
                            },
                            {
                                "id": "0,0,2,1",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,2,2",
                                "type": 4,
                                "elements": " или клавишей \"~\".",
                                "format_id": "fa94a7b6-8887-45a4-b28a-ed7dcdf6e8dc"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Пример:",
                                "format_id": "3973bc01-15c6-47f5-8af7-e7c6e2cdbcc4"
                            }
                        ]
                    }
                ],
                "format_name": "Пример",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Здесь объявлена размерность \"куб_м\", равная пятидесяти кубическим метрам. При вычислении она ",
                                "format_id": "fa94a7b6-8887-45a4-b28a-ed7dcdf6e8dc"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "подставляется в результат автоматически, поскольку в данном примере является наиболее простой.",
                                "format_id": "fa94a7b6-8887-45a4-b28a-ed7dcdf6e8dc"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
