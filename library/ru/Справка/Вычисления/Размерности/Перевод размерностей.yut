    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Ютово может переводить размерности из одной системы размерностей в другую, а также представлять результат в других размерностях той же системы.",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Перевод размерностей в пределах одной системы может происходить автоматически (если размерность не указана явно) при вычислении результата выражения. Для перевода результата в другую систему необходимо ее явно указывать.",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Автоматический выбор размерности происходит когда результат выражения вычисляется впервые. Для выбора конкретной размерности и системы мер предназначено контексное меню результата вычислений. В этом меню пользователь выбирает нужную систему мер и размерность, в которую он хочет перевести результат.",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Простые размерности",
                                "format_id": "fc9baea7-a714-4281-b68e-0cab40b2ef83"
                            }
                        ],
                        "format_name": "Заголовок 4"
                    }
                ],
                "format_name": "Заголовок 4",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Пример:",
                                "format_id": "fd15aa29-0e34-4511-92e9-eafcc0c796cd"
                            }
                        ],
                        "format_name": "Пример"
                    }
                ],
                "format_name": "Пример",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "В следующем примере используются размерности длины. Поскольку система мер не определена, используется определяемая по умолчанию метрическая система (СИ). При вычислениях происходит автоматический подбор наиболее подходящей размерности. Все используемые в примере размерности являются встроенными.",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ],
                        "format_name": "Основной текст"
                    }
                ],
                "format_name": "Основной текст",
                "format_alignment": 0
            },
