            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Поддерживаются четыре системы счисления: двоичная (bin), восьмеричная (oct), десятичная (dec), шестнадцатеричная ",
                                "format_id": "dc7bb92a-3900-4747-a307-0dc13ad3a636"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
