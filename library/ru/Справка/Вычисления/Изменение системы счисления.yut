            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "В настройках целых чисел можно задавать систему счисления по умолчанию и систему счисления для результата. Для ",
                                "format_id": "46bf57c9-7b11-4eeb-9d04-0bf6b84900cc"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "конкретных вычислений можно выбирать систему счисления отдельно.",
                                "format_id": "46bf57c9-7b11-4eeb-9d04-0bf6b84900cc"
                            }
                        ]
