                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Изменение системы счисления возможно только для целых чисел.",
                                "format_id": "46bf57c9-7b11-4eeb-9d04-0bf6b84900cc"
                            }
                        ]
                    }
                ],
                "format_name": "Основной текст",
