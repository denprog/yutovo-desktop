                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "результате и выберите \"Размерность\".",
                                "format_id": "5bd99a52-8b24-4580-bc8e-91860e94398e"
                            }
                        ]
