                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "La calculadora de rendimiento a la oferta calcula el rendimiento anual total de un bono, cuando se compra al precio actual, se mantiene hasta la fecha de la oferta y la reinversión de todos los pagos de ",
                                "format_id": "8c6ed6bd-9448-4be0-b1fb-2a9c7fbaf186"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "cupones a la misma tasa. Cambie los parámetros y el resultado se volverá a calcular.",
                                "format_id": "8c6ed6bd-9448-4be0-b1fb-2a9c7fbaf186"
                            }
                        ]
                    }
                ],
