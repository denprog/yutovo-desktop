                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "• Cambiar el correo electrónico;",
                                "format_id": "6c5be3ed-5feb-4df0-9edd-f72a737e95d1"
                            }
