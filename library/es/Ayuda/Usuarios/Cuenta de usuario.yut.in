                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Tras iniciar sesión correctamente, el usuario tiene acceso a las siguientes opciones, que se encuentran en el cuadro de diálogo que aparece al hacer clic en el botón de inicio de sesión:",
                                "format_id": "846c7ced-52d5-4c34-890c-0ed2736b7ba7"
                            }
                        ],
                        "format_name": "Cuerpo de texto"
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
#else
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Los usuarios registrados en el ",
                                "format_id": "846c7ced-52d5-4c34-890c-0ed2736b7ba7"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 39,
                                "level": 1,
                                "elements": "sitio",
                                "format_id": "d338b315-a9b4-4a00-8a75-7f4d6e02c9b0",
                                "url": "https://yutovo.com"
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "level": 1,
                                "elements": " tienen acceso a las siguientes funciones una vez que hayan iniciado sesión correctamente, las cuales se encuentran en el cuadro de diálogo que se abre al hacer clic en \"Iniciar sesión\":",
                                "format_id": "846c7ced-52d5-4c34-890c-0ed2736b7ba7"
                            }
                        ],
                        "format_name": "Cuerpo de texto"
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
#endif
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "• Cerrar sesión;",
                                "format_id": "6c5be3ed-5feb-4df0-9edd-f72a737e95d1"
                            }
                        ]
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "• Cambiar el nombre introducido durante el registro (no el nombre de usuario, ya que no se puede cambiar);",
                                "format_id": "6c5be3ed-5feb-4df0-9edd-f72a737e95d1"
                            }
                        ]
                    }
                ],
                "format_name": "Cuerpo de texto",
