                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Yutovo admite variables y funciones de usuario. Gracias a ellas, el usuario no se limita a las funciones integradas, sino que puede ampliarlas.",
                                "format_id": "126038ca-00c0-44f9-82f2-7512ebddf304"
                            }
                        ]
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Cualquier expresión de usuario (variable, función o dimensión) debe declararse antes de su primer uso.",
                                "format_id": "126038ca-00c0-44f9-82f2-7512ebddf304"
                            }
                        ]
                    }
                ],
                "format_name": "Cuerpo de texto",
