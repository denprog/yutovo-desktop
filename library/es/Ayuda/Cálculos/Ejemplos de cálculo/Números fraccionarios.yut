                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Se aplica una fuerza tangencial F = 19,6 N al borde de un disco con una masa de m = 5 kg. ¿Qué energía cinética W_k tendrá el disco después de un tiempo de t = 5 s desde que la fuerza comienza a ",
                                "format_id": "68bafffa-26de-4d4e-9c4c-e45d116cf637"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "actuar? El resultado se presenta como una fracción común.",
                                "format_id": "68bafffa-26de-4d4e-9c4c-e45d116cf637"
                            }
                        ]
                    }
                ],
                "format_name": "Cuerpo de texto",
