    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Inicialmente, la expresión se calcula mediante la selección automática del tipo de resultado. Sin embargo, para facilitar la presentación, se puede cambiar el tipo de resultado calculado después del símbolo ",
                                "format_id": "819150bc-8dd5-41ad-bae6-7fd2ff59c651"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "igual. Para ello, haga clic derecho en el resultado y seleccione el tipo de resultado deseado en el submenú \"Presentación como\".",
                                "format_id": "819150bc-8dd5-41ad-bae6-7fd2ff59c651"
                            }
                        ]
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
            {
