                        "level": 1,
                        "elements": [
                            {
                                "id": "0,20,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "La unidad resultante en este caso es metros por segundo. Es compuesta porque no se declaró ninguna unidad equivalente. Con base en esta unidad y las unidades integradas basadas en metros y segundos, se pueden crear diversas combinaciones y presentarlas en el cuadro de diálogo de unidades. Por ejemplo, seleccione \"cm/s\".",
                                "format_id": "ab08fe1c-c6ae-4e9b-ac2f-da1009076d11"
                            }
                        ],
                        "format_name": "Cuerpo de texto"
                    }
                ],
