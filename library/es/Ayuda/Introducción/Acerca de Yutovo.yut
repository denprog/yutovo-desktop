    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Yutovo es una aplicación para resolver diversos problemas matemáticos. Yutovo ofrece una vista visual en papel para los cálculos. Utiliza una sintaxis matemática generalmente aceptada para mostrar las fórmulas. Yutovo está diseñado para resolver tanto tareas cotidianas como de ingeniería y es adecuado para una amplia variedad de usuarios en diferentes ámbitos.",
                                "format_id": "0d8c824d-33c1-4a6a-8ed0-15899e3cc5b2"
                            }
                        ],
                        "format_name": "Cuerpo de texto"
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Yutovo utiliza una representación gráfica de fórmulas matemáticas.",
                                "format_id": "0d8c824d-33c1-4a6a-8ed0-15899e3cc5b2"
                            }
                        ],
                        "format_name": "Cuerpo de texto"
                    }
                ],
                "format_name": "Cuerpo de texto",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "level": 1,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "• Los resultados de los cálculos pueden tener cualquier número de dígitos y ",
                                "format_id": "0d8c824d-33c1-4a6a-8ed0-15899e3cc5b2"
                            },
                            {
