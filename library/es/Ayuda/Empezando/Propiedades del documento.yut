                        "type": 3,
                        "level": 1,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "level": 1,
                                "elements": "Cada documento tiene un conjunto de ajustes que se configuran en el cuadro de diálogo Propiedades del documento, al que se accede haciendo clic en el botón ",
                                "format_id": "b6224706-5fa8-4eea-9bd8-b7069bbc0bc8"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 34,
